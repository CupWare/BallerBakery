			end

			local function holdActive()
				return next(Hold.users) ~= nil
			end

			local function removeHoldForce()
				if Hold.conn then Hold.conn:Disconnect() end
				if Hold.velocity then Hold.velocity:Destroy() end
				Hold.conn, Hold.velocity = nil, nil
			end

			-- Makes sure the hold exists on your current character (rebuilt after a respawn)
			local function ensureHold()
				local char, root, hum = getCharacterParts()
				if not (char and root and hum and hum.Health > 0) then return false end
				hum.PlatformStand = true
				if Hold.velocity and Hold.velocity.Parent == root and Hold.conn then return true end

				removeHoldForce()
				Hold.collide = {}
				Hold.savedCFrame = Hold.savedCFrame or root.CFrame
				Hold.target = Hold.target or root.CFrame
				root.Anchored = false

				Hold.velocity = Instance.new("BodyVelocity")
				Hold.velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
				Hold.velocity.Velocity = Vector3.zero
				Hold.velocity.Parent = root

				Hold.conn = RunService.Heartbeat:Connect(function()
					-- Hold.follow (optional) recomputes the spot every frame, e.g. under a moving mob
					if Hold.follow then
						local ok, cf = pcall(Hold.follow)
						if ok and typeof(cf) == "CFrame" then Hold.target = cf end
					end
					if not (root.Parent and Hold.target) then return end
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") and part.CanCollide then
							if Hold.collide[part] == nil then Hold.collide[part] = true end
							part.CanCollide = false
						end
					end
					-- Anchored once settled: tested that anchoring only works AFTER the server
					-- has seen the new position (anchor first = server never sees the move).
					-- So: unanchored while moving / following a mob, anchored once arrived.
					local settled = not Hold.follow and os.clock() >= (Hold.settleAt or 0)
					if root.Anchored ~= settled then root.Anchored = settled end
					root.CFrame = Hold.target
					if not settled then root.AssemblyLinearVelocity = Vector3.zero end
					if not hum.PlatformStand then hum.PlatformStand = true end
				end)
