			end

			Hub.onShutdown(function() TargetHighlight:Destroy() end)

			local function acquireHold(user)
				if not holdActive() then
					Hub.lock("farm", true) -- pauses Fly / Infinite Jump first
				end
				Hold.users[user] = true
				return ensureHold()
			end

			-- Gives your character back once no feature needs the hold any more
			local function releaseHold(user)
				if not Hold.users[user] then return end -- wasn't holding: nothing to undo
				Hold.users[user] = nil
				if holdActive() then return end

				local hadHold = Hold.velocity ~= nil
				removeHoldForce()
				local _, root, hum = getCharacterParts()
				if root then root.Anchored = false end
				for part in pairs(Hold.collide) do
					if part.Parent then part.CanCollide = true end
				end
				if hadHold and root then
					if Hold.savedCFrame then root.CFrame = Hold.savedCFrame end
					root.AssemblyLinearVelocity = Vector3.zero
				end
				if hum then hum.PlatformStand = false end
				Hold.target, Hold.savedCFrame, Hold.collide, Hold.follow = nil, nil, {}, nil
				focusStop() -- everything visible again
				Hub.lock("farm", false) -- Fly comes back if it was on
			end

			-- lookAt (optional): turn the character to face that point, e.g. up at a rock
			local function moveUnder(position, lookAt)
				local spot = position - Vector3.new(0, UNDER_DEPTH, 0)
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local from = (root and root.Position) or (Hold.target and Hold.target.Position) or spot
				local distance = (from - spot).Magnitude
				local moved = not Hold.target or (Hold.target.Position - spot).Magnitude > 0.5
				if lookAt and (lookAt - spot).Magnitude > 0.1 then
					-- zAxis as "up" so looking straight up still works
					Hold.target = CFrame.lookAt(spot, lookAt, Vector3.zAxis)
				else
					Hold.target = CFrame.new(spot)
				end
				-- New spot: stay unanchored so the server sees it, then anchor. Long trips
				-- need longer (tested: a 200+ stud trip anchored after 0.4s was not seen by
				-- the server, so a shop purchase there was refused; 1.2s worked).
				if moved then Hold.settleAt = os.clock() + (distance > 80 and 1.2 or SETTLE_TIME) end
			end

			-- Only one feature moves the character at a time
			-- Fair queue: features take turns in the order they asked, so a farm that
			-- loops straight back (mine/mobs/trees) can't starve Auto Repair / Sell / Feed.
			local MoverBusy = false
			local MoverQueue = {}
			local function withMover(fn)
				local ticket = {}
				table.insert(MoverQueue, ticket)
				while MoverBusy or MoverQueue[1] ~= ticket do task.wait() end
				table.remove(MoverQueue, 1)
				MoverBusy = true
				local ok, err = pcall(fn)
				MoverBusy = false
				if not ok then warn("[BallerBakery] " .. tostring(err)) end
			end

			-- One moving farm at a time: turning on Auto Harvest / Auto Mine / Auto Farm Mobs /
			-- Auto Chop switches the others off (their toggles too). Helpers that only borrow
			-- you briefly (Plant, Collect, Sell, Feed, Repair, Buy, Claim) keep running.
			local MovingFarms = {}
			local function findToggle(tab, title)
				for _, d in ipairs(tab.PageContainer:GetDescendants()) do
					if d.Name == "Toggle" and d:FindFirstChild("Title") and d.Title.Text == title then return d end
				end
			end
			local function registerFarm(name, tab, title, isOn)
				MovingFarms[name] = { frame = findToggle(tab, title), isOn = isOn }
			end
			local function stopOtherFarms(name)
				for other, farm in pairs(MovingFarms) do
					if other ~= name and farm.isOn() and farm.frame and farm.frame.Parent then
						pressButton(farm.frame.ToggleInvisibleClick)
					end
				end
			end

			-- Cave travel shared by every feature (one table = one local).
			-- The surface (farm, shops, Smithy, sea) doesn't load while you're in the cave,
			-- so surface jobs call Cave.surface() first; cave jobs call Cave.enter().
			local Cave = { went = false }
			pcall(function() Cave.config = require(ReplicatedStorage.Modules.Metadata.CaveConfig) end)
			-- Wait until a move has really landed (the server has seen you there), then a beat more
			function Cave.waitSettled()
				while os.clock() < (Hold.settleAt or 0) do task.wait() end
				task.wait(0.4)
			end
			function Cave.myPos()
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				return root and root.Position
			end
			function Cave.inside(pos)
				if not (Cave.config and Cave.config.Inside and pos) then return false end
				local ok, inside = pcall(Cave.config.Inside, pos)
				return ok and inside and true or false
			end
			-- Go through a cave door the game's way: the server only accepts the trip when
			-- you're standing in the doorway (Map.Cave "Entrance" / "Exit" boxes), so walk
			-- into the door, let the game's own door trigger take you, and wait until you've
			-- really arrived before doing anything else.
			function Cave.door(name)
				local cave = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Map")
				cave = cave and cave:FindFirstChild("Cave")
				local door = cave and cave:GetAttribute(name)
				return typeof(door) == "CFrame" and door or nil
			end
			function Cave.goThrough(doorName, direction, wantInside)
				local door = Cave.door(doorName)
				if door then
					-- stand in the doorway (unanchored for a moment so the server sees it)
					Hold.follow = nil
					Hold.target = door
					Hold.settleAt = os.clock() + SETTLE_TIME
					task.wait(SETTLE_TIME + 0.2)
				end
				-- let go so the game can move you through (otherwise the hold pulls you back)
				Hold.target = nil
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if root then root.Anchored = false end
				local t0 = os.clock()
				local sent = false
				while os.clock() - t0 < 8 do
					if Cave.inside(Cave.myPos()) == wantInside then break end
					-- the game's door normally does it; if not after 1.5s, ask for the trip ourselves
					if not sent and os.clock() - t0 > 1.5 then
						RemoteManager.Fire("CaveTravel", direction)
						sent = true
					end
					task.wait(0.1)
				end
				task.wait(0.8) -- let the new area load
				local pos = Cave.myPos()
				if pos then
					Hold.target = CFrame.new(pos)
					Hold.settleAt = os.clock() + SETTLE_TIME
				end
				return Cave.inside(Cave.myPos()) == wantInside
			end
			-- NPCs far away unload (Roblox streams distant areas out), e.g. while you fish at
			-- the far shore. So remember where each NPC was last seen, and when one is
			-- missing, go back to that spot (on the surface) so it loads, then find it again.
			Cave.npcSeen = {}
			function Cave.findNpc(name)
				local npcs = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("NPCs")
				local npc = npcs and npcs:FindFirstChild(name)
				if npc then Cave.npcSeen[name] = npc:GetPivot().Position end
				return npc
			end
			function Cave.reachNpc(name, user)
				local npc = Cave.findNpc(name)
				if npc then return npc end
				if not (Cave.npcSeen[name] or Cave.inside(Cave.myPos())) then return nil end
				if acquireHold(user) then
					withMover(function()
						Cave.surface() -- shops and sellers are on the surface
						npc = Cave.findNpc(name)
						local seen = Cave.npcSeen[name]
						if not npc and seen then
							moveUnder(seen)
							local t0 = os.clock()
							repeat task.wait(0.2) npc = Cave.findNpc(name) until npc or os.clock() - t0 > 3
						end
					end)
					if not npc then releaseHold(user) end
				end
				return npc
			end
			task.spawn(function() -- keep the NPC spots fresh
				while Cave do
					local npcs = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("NPCs")
					for _, npc in ipairs(npcs and npcs:GetChildren() or {}) do
						if npc:IsA("Model") then Cave.npcSeen[npc.Name] = npc:GetPivot().Position end
					end
					task.wait(10)
				end
			end)

			function Cave.enter()
				if Cave.inside(Cave.myPos()) then return true end
				Cave.went = true
				return Cave.goThrough("Entrance", "In", true)
			end
			function Cave.surface()
				if not Cave.inside(Cave.myPos()) then return true end
				Cave.went = false
				return Cave.goThrough("Exit", "Out", false)
			end

			local function gardenCenter(gardenName)
				local garden = getGarden(gardenName)
				return garden and (garden:GetBoundingBox()).Position
			end

			----------------------------------------------------------------
			-- Auto harvest: stops under the middle of each garden and harvests all its ripe plants at once
			-- (any crop, ticked or not - the ticks are only for Auto Plant)
			----------------------------------------------------------------
			local AutoHarvestOn = false
			local HarvestLoopId = 0
			local Pending = {} -- plant Id -> time sent, so the same plant isn't spammed

			local function harvestRunning(myLoop)
				return AutoHarvestOn and HarvestLoopId == myLoop
			end

			AutomationSec:CreateToggle("Auto Harvest (all gardens)", function(state)
				AutoHarvestOn = state
				if state then stopOtherFarms("harvest") end
				HarvestLoopId += 1
				if not state then
					releaseHold("harvest") -- puts you back where you were
					return
				end

				local myLoop = HarvestLoopId
				task.spawn(function()
					local warned = {}
					while harvestRunning(myLoop) do
						local gardenState = getGardenState()
						if not gardenState then
							if not warned.data then
								warned.data = true
								warn("[BallerBakery] Couldn't find your garden data yet, retrying in 10s")
							end
							task.wait(10)
						elseif not acquireHold("harvest") then
							task.wait(1) -- no character (respawning), try again
						else
							withMover(function()
								Cave.surface() -- your gardens are on the surface: go up first if in the cave
								-- (the garden being harvested gets outlined below)
								-- One stop per garden: from 8 studs under the garden's center every
								-- plot is within reach (farthest ~21 studs), so all ripe plants are
								-- harvested in one burst instead of moving plant by plant.
								local parked = false
								for _, gardenName in ipairs(GardenNames) do
									if not harvestRunning(myLoop) then return end
									local gardenId = GardenIds[gardenName]
									local center = gardenCenter(gardenName)

									local now = os.clock()
									local ripe = {}
									for plantId, view in pairs(gardenState.views) do
										local sentAt = Pending[plantId]
										if type(view) == "table" and view.kind == "Plant" and view.ripe
											and view.penIndex == gardenId and (not sentAt or now - sentAt > 1) then
											table.insert(ripe, plantId)
										end
									end

									if center and (#ripe > 0 or not parked) then
										moveUnder(center) -- also where you wait when nothing is ripe
										highlightTarget(getGarden(gardenName))
										parked = true
									end

									if center and #ripe > 0 then
										-- Just moved here? 0.15s is enough for the server to see the new spot
										-- (tested: 17/18 harvested at 0.15s). Already here: harvest instantly.
										if os.clock() < (Hold.settleAt or 0) then task.wait(0.1) end
										if not harvestRunning(myLoop) then return end
										for _, plantId in ipairs(ripe) do
											Pending[plantId] = os.clock()
											RemoteManager.Fire("GardenAction", "Harvest", gardenId, plantId)
										end
									end
								end
							end)
							task.wait(0.05) -- check again almost right away
						end
					end
				end)
			end)

			----------------------------------------------------------------
			-- Player data helpers (the game stores these as JSON in LocalPlayer.Data)
			----------------------------------------------------------------
			local HttpService = game:GetService("HttpService")

			local function readData(field)
				local data = LocalPlayer:FindFirstChild("Data")
				local value = data and data:FindFirstChild(field)
				if not value then return nil end
				if type(value.Value) ~= "string" then return value.Value end
				local ok, decoded = pcall(HttpService.JSONDecode, HttpService, value.Value)
				return ok and decoded or nil
			end

			local function notify(title, text)
				pcall(function()
					VanixiaUI:CreateNotification({ Title = title, Description = text, Icon = "info", Theme = "Dark", Duration = 3 })
				end)
			end

			----------------------------------------------------------------
			-- Auto collect pet drops: the pen menu's free "Collect All" (HarvestGoods).
			-- No teleporting. Tested working ~100 studs from the pet pen (not from ~500),
			-- so it works anywhere on your farm, including while Auto Harvest moves you.
			----------------------------------------------------------------
			local AutoCollectOn = false
			local CollectLoopId = 0

			local function petDropCount()
				local penDrops = readData("PenDrops")
				local count = 0
				if type(penDrops) == "table" and type(penDrops.Drops) == "table" then
					for _, list in pairs(penDrops.Drops) do
						if type(list) == "table" then count += #list end
					end
				end
				return count
			end

			AutomationSec:CreateToggle("Auto Collect Pet Drops", function(state)
				AutoCollectOn = state
				CollectLoopId += 1
				if not state then return end

				local myLoop = CollectLoopId
				task.spawn(function()
					while AutoCollectOn and CollectLoopId == myLoop do
						if petDropCount() > 0 then
							RemoteManager.Fire("HarvestGoods")
							task.wait(5) -- give the server time before asking again
						else
							task.wait(2)
						end
					end
				end)
			end)

			do -- calculator block (own scope: Luau allows 200 locals per function)
			----------------------------------------------------------------
			-- Earnings calculator: for each ticked garden with a crop picked, works out
			-- how many plots you can fill (30, or fewer if you don't have enough seeds),
			-- harvests per hour from the crop's grow time, and crackles per hour from
			-- its sell value (all from the game's own CropConfig). Updates every 3s.
			----------------------------------------------------------------
			local CropConfig = require(ReplicatedStorage.Modules.Metadata.CropConfig)
			local SeedPrices = require(ReplicatedStorage.Modules.Metadata.SeedShopConfig)
			local CYCLE_OVERHEAD = 0.5 -- seconds to harvest + replant each round

			local CalcSec = UISection(AutoFarmTab, "Earnings Calculator")
			local beforeCalc = {}
			for _, c in ipairs(CalcSec.PageContainer:GetChildren()) do beforeCalc[c] = true end
			CalcSec:CreateParagraph("Per Hour", "Tick a garden and pick a crop to see your earnings")
			local CalcBody
			for _, c in ipairs(CalcSec.PageContainer:GetChildren()) do
				if not beforeCalc[c] and c.Name == "Paragraph" then CalcBody = c:FindFirstChild("Body", true) end
			end

			local function shortTime(seconds)
				seconds = math.max(0, math.floor(seconds))
				if seconds >= 3600 then return ("%dh %dm"):format(seconds // 3600, (seconds % 3600) // 60) end
				if seconds >= 60 then return ("%dm %ds"):format(seconds // 60, seconds % 60) end
				return seconds .. "s"
			end

			local function commas(n)
				local s = tostring(math.floor(n + 0.5))
				return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
			end

			local function calculate()
				local seedsOwned = readData("Seeds") or {}
				local seedsLeft = {}
				for name, count in pairs(seedsOwned) do seedsLeft[name] = tonumber(count) or 0 end

				local lines, totalPerHour, totalIfBuying = {}, 0, 0
				for _, gardenName in ipairs(GardenNames) do
					local settings = Gardens[gardenName]
					if settings.Enabled and settings.Crop then
						local seed = settings.Crop
						local crop = CropConfig.CropOf(seed)
						local def = crop and CropConfig.Get(crop)
						if def and def.GrowTime and def.Value then
							-- gardens using the same seed share your seed stock
							local have = seedsLeft[seed] or 0
							local plots = math.min(PLOT_COUNT, have)
							seedsLeft[seed] = have - plots

							local cycle = def.GrowTime + CYCLE_OVERHEAD
							local roundsPerHour = 3600 / cycle
							local fullPerHour = PLOT_COUNT * roundsPerHour * def.Value -- with endless seeds
							local price = SeedPrices.Get(seed).Price or 0
							local profitPerHour = PLOT_COUNT * roundsPerHour * (def.Value - price)

							local line
							if plots == 0 then
								line = ("%s · %s\n   no %s left (buy some in the Shop tab)\n   full garden would make %s / hour"):format(
									gardenName, crop, seed, commas(fullPerHour))
							else
								-- every replant uses a seed: how long do your seeds last?
								local seedsPerHour = plots * roundsPerHour
								local lastsFor = have / seedsPerHour * 3600
								local earnedThisHour = math.min(have, seedsPerHour) * def.Value
								totalPerHour += earnedThisHour
								line = ("%s · %s  ×%d plots  (%d seeds)\n   %s grow · %.0f harvests/h · %d each\n   ≈ %s crackles this hour%s"):format(
									gardenName, crop, plots, have, shortTime(def.GrowTime), roundsPerHour, def.Value,
									commas(earnedThisHour),
									lastsFor < 3600 and (" · seeds run out in " .. shortTime(lastsFor)) or "")
							end
							totalIfBuying += profitPerHour
							table.insert(lines, line)
						end
					end
				end

				if #lines == 0 then return "Tick a garden and pick a crop to see your earnings" end
				table.insert(lines, ("\nTOTAL ≈ %s crackles this hour with your seeds"):format(commas(totalPerHour)))
				table.insert(lines, ("Full gardens nonstop (buying seeds): ≈ %s profit / hour"):format(commas(totalIfBuying)))
				table.insert(lines, "(base values; sprinklers, weather and bonus seeds can raise it)")
				return table.concat(lines, "\n")
			end

			local CalcOn = true
			task.spawn(function()
				while CalcOn do
					if CalcBody and CalcBody.Parent then
						local ok, text = pcall(calculate)
						CalcBody.Text = ok and text or "Couldn't calculate right now"
					end
					task.wait(3)
				end
			end)
			Hub.onShutdown(function() CalcOn = false end)
			end -- calculator block

			----------------------------------------------------------------
			-- Extras tab: selling, daily rewards, pets
			----------------------------------------------------------------
			local ExtrasTab = Window:CreateTab("Extras", "zap")

			local ItemLocks
			pcall(function() ItemLocks = require(ReplicatedStorage.Modules.Utility.ItemLocks) end)

			local function isLocked(name)
				if not (ItemLocks and ItemLocks.IsLocked) then return false end
				local ok, locked = pcall(ItemLocks.IsLocked, "Goods", name)
				return ok and locked == true
			end

			-- Crops and pet drops you can sell (items you locked in the game are skipped)
			local function sellableItems()
				local items, total = {}, 0
				for _, field in ipairs({ "Crops", "Produce" }) do
					local list = readData(field)
					if type(list) == "table" then
						for name, count in pairs(list) do
							if type(name) == "string" and type(count) == "number" and count > 0 and not isLocked(name) then
								table.insert(items, { name, count })
								total += count
							end
						end
					end
				end
				return items, total
			end

			-- Selling only works near Eino (the Seller), so this moves you
			-- hidden under Eino for a moment, sells, then puts you back.
			local Selling = false
			local function sellNow(pick) -- pick: optional {{name, count}, ...}; default sells everything
				if Selling then return nil, "already selling" end
				local items, total = sellableItems()
				if pick then
					items, total = pick, 0
					for _, item in ipairs(pick) do total += item[2] end
				end
				if total == 0 then return nil, "nothing to sell" end
				local npcs = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("NPCs")
				local eino = Cave.reachNpc("Eino", "sell") -- goes to where Eino was if he unloaded
				if not eino and Cave.inside(Cave.myPos()) and acquireHold("sell") then -- Eino is on the surface
					withMover(Cave.surface)
					eino = npcs and npcs:FindFirstChild("Eino")
					if not eino then releaseHold("sell") end
				end
				if not eino then return nil, "couldn't find Eino (the Seller)" end

				Selling = true
				local crackles = LocalPlayer.Data:FindFirstChild("Crackles")
				local before = crackles and crackles.Value or 0
				if acquireHold("sell") then
					withMover(function()
						moveUnder(eino:GetPivot().Position)
						Cave.waitSettled() -- until the server has seen you at Eino
						RemoteManager.Fire("SellProduce", { Items = items, Fish = {}, Tools = {} })
						local t0 = os.clock()
						while crackles and crackles.Value == before and os.clock() - t0 < 2 do task.wait() end
					end)
				end
				releaseHold("sell")
				Selling = false
				local earned = (crackles and crackles.Value or 0) - before
				return earned, total
			end

			local SellSec = UISection(ExtrasTab, "Selling")
			SellSec:CreateButton("Sell Crops & Pet Drops Now", function()
				task.spawn(function()
					local earned, info = sellNow()
					if earned then
						notify("Sold", ("Sold %d items for %d Crackles"):format(info, earned))
					else
						notify("Sell", "Nothing sold: " .. tostring(info))
					end
				end)
			end)

			local AutoSellOn = false
			local SellLoopId = 0
			local SellMinutes = 1
			SellSec:CreateSlider("Auto Sell Every (minutes)", 1, 30, 1, function(value) SellMinutes = math.floor(value) end)
			SellSec:CreateToggle("Auto Sell Crops & Pet Drops", function(state)
				AutoSellOn = state
				SellLoopId += 1
				if not state then return end

				local myLoop = SellLoopId
				task.spawn(function()
					while AutoSellOn and SellLoopId == myLoop do
						local _, total = sellableItems()
						if total > 0 then sellNow() end
						for _ = 1, SellMinutes * 60 do
							if not (AutoSellOn and SellLoopId == myLoop) then break end
							task.wait(1)
						end
					end
				end)
			end)

			do -- Sell value block (own scope)
			----------------------------------------------------------------
			-- Sell Value: what your crops and pet drops are worth right now, from the
			-- game's own Goods values (tested: sold 10 Blueberry + 1 Wool, expected
			-- 75, got 75). Sell For Amount sells only enough to reach a target:
			-- cheapest items first (keeps your rare stuff), topped off with the
			-- cheapest single item that covers the rest, so you get the amount or a
			-- little more.
			----------------------------------------------------------------
			local Goods
			pcall(function() Goods = require(ReplicatedStorage.Modules.Utility.Goods) end)
			local function unitValue(name)
				if not Goods then return 0 end
				local ok, def = pcall(Goods.Get, name)
				return ok and type(def) == "table" and tonumber(def.Value) or 0
			end
			local function commas(n)
				local s = tostring(math.floor(n + 0.5))
				return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
			end

			-- every sellable stack with its value, cheapest first
			local function valuedStacks()
				local stacks = {}
				for _, field in ipairs({ "Crops", "Produce" }) do
					local list = readData(field)
					if type(list) == "table" then
						for name, count in pairs(list) do
							local value = unitValue(name)
							if type(name) == "string" and type(count) == "number" and count > 0 and value > 0 and not isLocked(name) then
								table.insert(stacks, { name = name, count = count, value = value, field = field })
							end
						end
					end
				end
				table.sort(stacks, function(a, b)
					if a.value ~= b.value then return a.value < b.value end
					return a.name < b.name
				end)
				return stacks
			end

			local function sellValueText()
				local stacks = valuedStacks()
				if #stacks == 0 then return "Nothing to sell" end
				local sums = { Crops = 0, Produce = 0 }
				local counts = { Crops = 0, Produce = 0 }
				for _, s in ipairs(stacks) do
					sums[s.field] += s.count * s.value
					counts[s.field] += s.count
				end
				table.sort(stacks, function(a, b) return a.count * a.value > b.count * b.value end)
				local lines = {
					("Crops: %s items  →  %s Crackles"):format(commas(counts.Crops), commas(sums.Crops)),
					("Pet drops: %s items  →  %s Crackles"):format(commas(counts.Produce), commas(sums.Produce)),
					("TOTAL  →  %s Crackles"):format(commas(sums.Crops + sums.Produce)),
					"",
				}
				for i = 1, math.min(6, #stacks) do
					local s = stacks[i]
					table.insert(lines, ("%s ×%s  (%d each)  =  %s"):format(s.name, commas(s.count), s.value, commas(s.count * s.value)))
				end
				if #stacks > 6 then table.insert(lines, ("...and %d more"):format(#stacks - 6)) end
				return table.concat(lines, "\n")
			end

			-- What to sell to get at least `target` Crackles with as little extra as possible
			local function planForAmount(target)
				local stacks = valuedStacks() -- cheapest first
				local total = 0
				for _, s in ipairs(stacks) do total += s.count * s.value end
				if total < target then return nil, total end
				local take, left = {}, target
				for _, s in ipairs(stacks) do
					if left <= 0 then break end
					local n = math.min(s.count, left // s.value)
					if n > 0 then
						take[s.name] = n
						left -= n * s.value
					end
				end
				if left > 0 then
					-- top off with the cheapest single item that covers what's left
					local best
					for _, s in ipairs(stacks) do
						if s.count - (take[s.name] or 0) > 0 and s.value >= left then best = s break end
					end
					if best then
						take[best.name] = (take[best.name] or 0) + 1
						left -= best.value
					else
						-- nothing big enough on its own: keep adding the cheapest leftovers
						for _, s in ipairs(stacks) do
							while left > 0 and s.count - (take[s.name] or 0) > 0 do
								take[s.name] = (take[s.name] or 0) + 1
								left -= s.value
							end
						end
					end
				end
				local items, value = {}, 0
				for _, s in ipairs(stacks) do
					if take[s.name] then
						table.insert(items, { s.name, take[s.name] })
						value += take[s.name] * s.value
					end
				end
				return items, value
			end

