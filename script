			-- half mined the game reveals what's inside (attribute "Ores"), so rocks
			-- that turn out to have none of your ores are skipped.
			----------------------------------------------------------------
			local MiningTab = Window:CreateTab("Mining", "pickaxe")
			local MiningConfig = require(ReplicatedStorage.Modules.Metadata.MiningConfig)
			local ToolsNet = require(ReplicatedStorage.Modules.Namespaces.Tools)

			local RockDefs = {}
			for _, def in ipairs(MiningConfig.Rocks or {}) do RockDefs[def.Name] = def end

			-- "Copper Ore" (item) -> "Copper" (ore name used in rock weights)
			local function oreKey(itemName)
				local ok, ore = pcall(MiningConfig.OreOfItem, itemName)
				return (ok and type(ore) == "table" and ore.Name) or itemName
			end

			local function droppersOf(itemName)
				local key, rocks = oreKey(itemName), {}
				for name, def in pairs(RockDefs) do
					if type(def.Weights) == "table" and def.Weights[key] then table.insert(rocks, name) end
				end
				table.sort(rocks)
				return rocks
			end

			local OreItems = {}
			local oreFolder = ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("Ores")
			for _, ore in ipairs(oreFolder and oreFolder:GetChildren() or {}) do table.insert(OreItems, ore.Name) end
			table.sort(OreItems)

			local function pickaxeDef(name)
				local ok, def = pcall(MiningConfig.Pickaxe, name)
				return ok and type(def) == "table" and def or nil
			end

			local function isPickaxe(tool)
				return tool:IsA("Tool") and (tool:GetAttribute("ItemKind") == "Pickaxe" or pickaxeDef(tool.Name) ~= nil)
			end

			local function heldPickaxe()
				local char = LocalPlayer.Character
				local tool = char and char:FindFirstChildOfClass("Tool")
				return tool and isPickaxe(tool) and tool or nil
			end

			local function bestPickaxe()
				local best, bestPower = nil, -1
				for _, container in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
					for _, tool in ipairs(container and container:GetChildren() or {}) do
						if isPickaxe(tool) then
							local def = pickaxeDef(tool.Name)
							local power = def and def.Power or 0
							if power > bestPower then best, bestPower = tool, power end
						end
					end
				end
				return best
			end

			local function canBreak(rockDef, pickaxe)
				if not rockDef.Need then return true end
				local need, have = pickaxeDef(rockDef.Need), pickaxeDef(pickaxe.Name)
				return not need or (have and (have.Power or 0) >= (need.Power or 0))
			end

			local SelectedOres = {}
			local MineEverything = false
			local AutoEquipBest = true -- always use your best pickaxe

			-- Status line
			local MineSec = UISection(MiningTab, "Mining")
			local miningPage = MineSec.PageContainer
			local beforeStatus = {}
			for _, c in ipairs(miningPage:GetChildren()) do beforeStatus[c] = true end
			MineSec:CreateParagraph("Mining Status", "Off")
			local StatusBody
			for _, c in ipairs(miningPage:GetChildren()) do
				if not beforeStatus[c] and c.Name == "Paragraph" then StatusBody = c:FindFirstChild("Body", true) end
			end
			local function setStatus(text)
				if StatusBody and StatusBody.Parent then StatusBody.Text = text end
			end

			createSearchDropdown(MineSec, "Ores to mine", function()
				local items = {}
				for _, name in ipairs(OreItems) do
					local rocks = droppersOf(name)
					table.insert(items, { name = name, detail = #rocks > 0 and ("from " .. table.concat(rocks, ", ")) or "sea coral / other" })
				end
				return items
			end, SelectedOres)

			MineSec:CreateToggle("Mine Every Rock (ignore ore list)", function(state) MineEverything = state end)
			-- Off (partial mine): leave a rock once it's revealed without your ores.
			-- On (full mine): break the whole rock anyway, and finish rocks left half-mined.
			local FullBreak = false
			MineSec:CreateToggle("Fully Break Rocks (even without your ores)", function(state) FullBreak = state end)

			-- Picks the best rock: revealed rocks with a wanted ore first, then rocks that can drop one, nearest first
			local function chooseRock(pickaxe)
				local wanted, any = {}, false
				for item in pairs(SelectedOres) do wanted[oreKey(item)] = true any = true end
				if not MineEverything and not any then return nil, "pick some ores (or turn on Mine Every Rock)" end

				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local from = root and root.Position or Vector3.zero
				local best, bestScore
				for _, rock in ipairs(workspace.World.Ores:GetChildren()) do
					local def = rock:IsA("Model") and RockDefs[rock:GetAttribute("RockType")]
					local hp = rock:GetAttribute("HP")
					if def and type(hp) == "number" and hp > 0 and canBreak(def, pickaxe) then
						local priority
						if MineEverything then
							priority = 1
						else
							local revealed = rock:GetAttribute("Ores")
							if type(revealed) == "string" and revealed ~= "" then
								for ore in revealed:gmatch("[^,]+") do
									if wanted[ore:gsub("^%s+", ""):gsub("%s+$", "")] then priority = 0 break end
								end
								-- revealed without your ores: only finished off in full-break mode
								if not priority and FullBreak then priority = 1 end
							elseif type(def.Weights) == "table" then
								for ore in pairs(wanted) do
									if def.Weights[ore] then priority = 1 break end
								end
							end
						end
						if priority then
							local score = priority * 100000 + (rock:GetPivot().Position - from).Magnitude
							if not bestScore or score < bestScore then best, bestScore = rock, score end
						end
					elseif rock:IsA("Model") and rock:GetAttribute("Coral") and type(hp) == "number" and hp > 0 then
						-- Corals in the sea (Ore = "Brain Coral", ...): mined when picked, or with Mine Every Rock
						local ore = rock:GetAttribute("Ore")
						if MineEverything or (type(ore) == "string" and wanted[oreKey(ore)]) then
							local score = (rock:GetPivot().Position - from).Magnitude
							if not bestScore or score < bestScore then best, bestScore = rock, score end
						end
					end
				end
				if not best then return nil, "no rocks for your ores right now (or your pickaxe is too weak)" end
				return best
			end

			local function stillWanted(rock)
				if MineEverything or FullBreak then return true end
				local revealed = rock:GetAttribute("Ores")
				if type(revealed) ~= "string" or revealed == "" then return true end
				for item in pairs(SelectedOres) do
					local key = oreKey(item)
					for ore in revealed:gmatch("[^,]+") do
						if ore:gsub("^%s+", ""):gsub("%s+$", "") == key then return true end
					end
				end
				return false
			end

			local AutoMineOn = false
			local MineLoopId = 0
			local function mineRunning(myLoop) return AutoMineOn and MineLoopId == myLoop end

			MineSec:CreateToggle("Auto Mine", function(state)
				AutoMineOn = state
				if state then stopOtherFarms("mine") end
				MineLoopId += 1
				if not state then
					releaseHold("mine")
					setStatus("Off")
					return
				end

				local myLoop = MineLoopId
				task.spawn(function()
					while mineRunning(myLoop) do
						-- Only swap tools when no other feature is mid-action (it might be swinging a sword)
						if AutoEquipBest and not MoverBusy then
							local best, hum = bestPickaxe(), LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
							if best and hum and best.Parent ~= LocalPlayer.Character then hum:EquipTool(best) task.wait(0.3) end
						end
						local pickaxe = heldPickaxe() or (AutoEquipBest and bestPickaxe()) or nil
						if not pickaxe then
							releaseHold("mine")
							setStatus("You don't have a pickaxe")
							task.wait(1)
						else
							local rock, problem = chooseRock(pickaxe)
							if not rock then
								releaseHold("mine")
								setStatus(problem)
								task.wait(2)
							elseif acquireHold("mine") then
								withMover(function()
									highlightTarget(rock) -- outline the rock you are mining
									-- Auto Farm Mobs may have switched you to a sword in between
									do -- always your best pickaxe
										local best, hum = bestPickaxe(), LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
										if best and hum and best.Parent ~= LocalPlayer.Character then hum:EquipTool(best) task.wait(0.3) end
									end
									pickaxe = heldPickaxe() or pickaxe
									local cf, size = rock:GetBoundingBox()
									local center = cf.Position
									-- Hidden 6 studs under the bottom of the rock (moveUnder subtracts 8),
									-- facing up at it, so mobs and players can't reach or see you
									moveUnder(center - Vector3.new(0, size.Y / 2 - 2, 0), center)
									task.wait(MOVE_DELAY + 0.2) -- move, settle, anchor
									local def = pickaxeDef(pickaxe.Name)
									local swing = (def and def.Swing or 0.5) + 0.05
									local swings = 0
									while mineRunning(myLoop) and rock.Parent and (rock:GetAttribute("HP") or 0) > 0
										and swings < 200 and heldPickaxe() and stillWanted(rock) do -- once revealed without your ores: leave
										local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
										if not root then break end
										setStatus(("Mining %s (%s)  HP %s/%s%s"):format(rock.Name, tostring(rock:GetAttribute("Place") or "?"),
											tostring(rock:GetAttribute("HP")), tostring(rock:GetAttribute("Hits")),
											rock:GetAttribute("Ores") and ("\nInside: " .. tostring(rock:GetAttribute("Ores"))) or ""))
										ToolsNet.Activate.send({ Action = "Use", Look = (center - root.Position).Unit })
										swings += 1
										task.wait(swing)
									end
								end)
							else
								task.wait(1)
							end
						end
					end
				end)
			end)

			----------------------------------------------------------------
			-- Combat tab: auto farm mobs (same idea as mining)
			-- Mobs live in workspace.World.Monsters with attributes Monster / Health / MaxHealth.
			-- You're held 6 studs under the mob (following it as it moves), facing up,
			-- swinging your sword. Tested: mobs couldn't hit you there.
			----------------------------------------------------------------
			local CombatTab = Window:CreateTab("Combat", "sword")
			local CombatConfig = require(ReplicatedStorage.Modules.Metadata.CombatConfig)

			local function mobKey(name) return (tostring(name):gsub("%s+", ""):lower()) end

			-- "WildFowl" (asset name) -> "Wild Fowl" (in-game name)
			local function spaced(name) return (name:gsub("(%l)(%u)", "%1 %2")) end

			local function mobTypes()
				local seen, list = {}, {}
				local function add(name)
					local key = mobKey(name)
					if not seen[key] then seen[key] = true table.insert(list, name) end
				end
				for _, mob in ipairs(workspace.World.Monsters:GetChildren()) do
					if mob:GetAttribute("Monster") then add(mob:GetAttribute("Monster")) end
				end
				local folder = ReplicatedStorage:FindFirstChild("Assets") and ReplicatedStorage.Assets:FindFirstChild("Monsters")
				for _, m in ipairs(folder and folder:GetChildren() or {}) do add(spaced(m.Name)) end
				table.sort(list)
				return list
			end

			local function swordDef(name)
				local ok, def = pcall(CombatConfig.Sword, name)
				return ok and type(def) == "table" and def or nil
			end

			local function isSword(tool)
				return tool:IsA("Tool") and (tool:GetAttribute("ItemKind") == "Sword" or swordDef(tool.Name) ~= nil)
			end

			local function heldSword()
				local char = LocalPlayer.Character
				local tool = char and char:FindFirstChildOfClass("Tool")
				return tool and isSword(tool) and tool or nil
			end

			local function bestSword()
				local best, bestDamage = nil, -1
				for _, container in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
					for _, tool in ipairs(container and container:GetChildren() or {}) do
						if isSword(tool) then
							local def = swordDef(tool.Name)
							local damage = def and def.Damage or 0
							if damage > bestDamage then best, bestDamage = tool, damage end
						end
					end
				end
				return best
			end

			local function equipBestSword()
				local best, hum = bestSword(), LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
				if best and hum and best.Parent ~= LocalPlayer.Character then hum:EquipTool(best) task.wait(0.3) end
			end

			local SelectedMobs = {}
			local AttackEveryMob = false
			local AutoEquipSword = true -- always use your best sword

			local CombatSec = UISection(CombatTab, "Mob Farming")
			local combatPage = CombatSec.PageContainer
			local beforeCombat = {}
			for _, c in ipairs(combatPage:GetChildren()) do beforeCombat[c] = true end
			CombatSec:CreateParagraph("Combat Status", "Off")
			local CombatStatus
			for _, c in ipairs(combatPage:GetChildren()) do
				if not beforeCombat[c] and c.Name == "Paragraph" then CombatStatus = c:FindFirstChild("Body", true) end
			end
			local function setCombatStatus(text)
				if CombatStatus and CombatStatus.Parent then CombatStatus.Text = text end
			end

			createSearchDropdown(CombatSec, "Mobs to farm", function()
				local alive = {}
				for _, mob in ipairs(workspace.World.Monsters:GetChildren()) do
					local key = mobKey(mob:GetAttribute("Monster") or mob.Name)
					if (mob:GetAttribute("Health") or 0) > 0 then alive[key] = (alive[key] or 0) + 1 end
				end
				local items = {}
				for _, name in ipairs(mobTypes()) do
					local n = alive[mobKey(name)] or 0
					table.insert(items, { name = name, detail = n > 0 and (n .. " alive now") or "none right now" })
				end
				return items
			end, SelectedMobs)

			CombatSec:CreateToggle("Attack Every Mob (ignore list)", function(state) AttackEveryMob = state end)

			local function mobRoot(mob)
				return mob:FindFirstChild("RootPart") or mob.PrimaryPart or mob:FindFirstChildWhichIsA("BasePart")
			end

			local function chooseMob()
				local wanted, any = {}, false
				for name in pairs(SelectedMobs) do wanted[mobKey(name)] = true any = true end
				if not AttackEveryMob and not any then return nil, "pick some mobs (or turn on Attack Every Mob)" end
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local from = root and root.Position or Vector3.zero
				local best, bestDist
				for _, mob in ipairs(workspace.World.Monsters:GetChildren()) do
					local hp = mob:GetAttribute("Health")
					local part = mobRoot(mob)
					if part and type(hp) == "number" and hp > 0
						and (AttackEveryMob or wanted[mobKey(mob:GetAttribute("Monster") or mob.Name)]) then
						local d = (part.Position - from).Magnitude
						if not bestDist or d < bestDist then best, bestDist = mob, d end
					end
				end
				if not best then return nil, "none of your mobs are alive right now, waiting for respawns" end
				return best
			end

			-- Mobs only spawn when a player is nearby, so if none are alive we go wait
			-- (hidden) at their spawn zone: workspace.World.MobSpawns[<mob name>] holds the zone parts.
			local spawnTurn = 0
			-- Cave helpers: the game's CaveConfig.Inside(position) tells if a spot is in the cave world
			local CaveConfig
			pcall(function() CaveConfig = require(ReplicatedStorage.Modules.Metadata.CaveConfig) end)
			local WentIntoCave = false
			local function insideCave(position)
				if not (CaveConfig and CaveConfig.Inside and position) then return false end
				local ok, inside = pcall(CaveConfig.Inside, position)
				return ok and inside and true or false
			end
			local function myPosition()
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				return root and root.Position
			end

			-- The Deepslate floor (Map.Level2Cave): Great Slate Mole, Slate Monarch, Slatling,
			-- Slate Crawler, Lichen Bat, Deep Lurker, Deepslate Skeleton live there, and their
			-- spawn zones only load while you're down there. (One table = one local.)
			local Level2 = {}
			function Level2.bounds()
				local cave = workspace.World:FindFirstChild("Map") and workspace.World.Map:FindFirstChild("Level2Cave")
				local lo, hi = cave and cave:GetAttribute("BoundsMin"), cave and cave:GetAttribute("BoundsMax")
				if typeof(lo) == "Vector3" and typeof(hi) == "Vector3" then return lo, hi end
			end
			function Level2.inside(pos)
				local lo, hi = Level2.bounds()
				return pos and lo and pos.X >= lo.X and pos.X <= hi.X and pos.Z >= lo.Z and pos.Z <= hi.Z and pos.Y >= lo.Y - 20 and pos.Y <= hi.Y
			end
			function Level2.isMob(name)
				local folder = workspace.World:FindFirstChild("MobSpawns") and workspace.World.MobSpawns:FindFirstChild(name)
				local note = folder and folder:GetAttribute("Note")
				return (type(note) == "string" and note:find("Layer 2") ~= nil) or name == "Slate Monarch"
			end
			function Level2.wanted()
				if AttackEveryMob then return false end -- "every mob" farms wherever you are
				for name in pairs(SelectedMobs) do
					if Level2.isMob(name) then return name end
				end
			end
			function Level2.center()
				local lo, hi = Level2.bounds()
				return lo and (lo + hi) / 2
			end

			-- Zones: each mob only spawns in its own place, and you have to be there first
			--   surface: Wild Fowl, Boar, Giant Boar
			--   L1 (cave): Mossling, Moss Beetle, Mushroom, Slime, Spider, Stone Golem, Mossling King
			--   L2 (Deepslate floor): everything else
			local SURFACE_MOBS = { ["Wild Fowl"] = true, ["Boar"] = true, ["Giant Boar"] = true }
			local CAVE1_MOBS = { ["Mossling"] = true, ["Moss Beetle"] = true, ["Mushroom"] = true, ["Slime"] = true,
				["Spider"] = true, ["Stone Golem"] = true, ["Mossling King"] = true }
			Level2.ZONES = { "surface", "L1", "L2" }
			Level2.ZONE_NAMES = { surface = "the surface", L1 = "the cave (level 1)", L2 = "the Deepslate floor (level 2)" }
			function Level2.zoneOf(name)
				if SURFACE_MOBS[name] then return "surface" end
				if CAVE1_MOBS[name] then return "L1" end
				return "L2"
			end
			function Level2.here()
				local pos = myPosition()
				if Level2.inside(pos) then return "L2" end
				if insideCave(pos) then return "L1" end
				return "surface"
			end
			function Level2.wantedZones()
				local zones, count = {}, 0
				if AttackEveryMob then return { surface = true, L1 = true, L2 = true }, 3 end
				for name in pairs(SelectedMobs) do
					local z = Level2.zoneOf(name)
					if not zones[z] then zones[z] = true count += 1 end
				end
				return zones, count
			end
			function Level2.nextZone(zones, here)
				local start = table.find(Level2.ZONES, here) or 0
				for i = 1, #Level2.ZONES do
					local z = Level2.ZONES[(start + i - 1) % #Level2.ZONES + 1]
					if zones[z] and z ~= here then return z end
				end
			end
			-- Travel between zones the game's way (cave entrance / exit), then to the right floor
			function Level2.travel(zone)
				local here = Level2.here()
				if here == zone then return end
				if zone == "surface" then Cave.surface() WentIntoCave = false return end
				if here == "surface" then Cave.enter() WentIntoCave = true end -- lands on level 1
				if zone == "L2" then
					local center = Level2.center()
					if center then moveUnder(center + Vector3.new(0, UNDER_DEPTH, 0)) task.wait(3) end
				elseif zone == "L1" and Level2.here() == "L2" then
					local cave = workspace.World:FindFirstChild("Map") and workspace.World.Map:FindFirstChild("Cave")
					local spawn = cave and cave:GetAttribute("Spawn")
					if typeof(spawn) == "CFrame" then moveUnder(spawn.Position + Vector3.new(0, UNDER_DEPTH, 0)) task.wait(3) end
				end
			end

			local function nextSpawnSpot()
				local folder = workspace.World:FindFirstChild("MobSpawns")
				if not folder then return nil end
				local options = {}
				local here = Level2.here()
				for _, typeFolder in ipairs(folder:GetChildren()) do
					-- only spawns in the zone you're in (others need travelling first)
					if (AttackEveryMob or SelectedMobs[typeFolder.Name]) and Level2.zoneOf(typeFolder.Name) == here then
						for _, zone in ipairs(typeFolder:GetChildren()) do
							if zone:IsA("BasePart") then table.insert(options, { name = typeFolder.Name, part = zone }) end
						end
					end
				end
				if #options == 0 then return nil end
				spawnTurn = spawnTurn % #options + 1 -- take turns between zones
				return options[spawnTurn]
			end

			local AutoMobsOn = false
			local MobsLoopId = 0
			local function mobsRunning(myLoop) return AutoMobsOn and MobsLoopId == myLoop end
			local MOB_DEPTH = 5.5 -- a bit closer so swings reach mobs while they walk

			CombatSec:CreateToggle("Auto Farm Mobs", function(state)
				AutoMobsOn = state
				if state then stopOtherFarms("mobs") end
				MobsLoopId += 1
				if not state then
					Hold.follow = nil
					if (WentIntoCave or Cave.went) and insideCave(myPosition()) then
						-- leave the cave the proper way (through the exit door), then you're put back
						WentIntoCave = false
						task.spawn(function()
							withMover(function() Cave.surface() end)
							releaseHold("mobs")
						end)
					else
						releaseHold("mobs")
					end
					setCombatStatus("Off")
					return
				end

				local myLoop = MobsLoopId
				task.spawn(function()
					local kills = 0
					while mobsRunning(myLoop) do
						-- Only swap tools when no other feature is mid-action (it might be mining)
						if not MoverBusy then equipBestSword() end -- your best sword (no-op if already held)
						if not (heldSword() or (AutoEquipSword and bestSword())) then
							releaseHold("mobs")
							setCombatStatus("You don't have a sword")
							task.wait(1)
						else
							local mob, problem = chooseMob()
							local here = Level2.here()
							local zones, zoneCount = Level2.wantedZones()
							if mob then Level2.emptySince = nil end

							-- Where should we be? Not in a picked zone: go to one. In one but nothing has
							-- been alive for 20s and other zones are picked: move on to the next zone.
							local goTo
							if not mob and zoneCount > 0 then
								if not zones[here] then
									goTo = Level2.nextZone(zones, here)
								else
									Level2.emptySince = Level2.emptySince or os.clock()
									if zoneCount > 1 and os.clock() - Level2.emptySince > 20 then
										goTo = Level2.nextZone(zones, here)
									end
								end
							end

							-- Slate Monarch picked, on its floor, none alive: collect shards / summon it
							local handled = not mob and not goTo and here == "L2" and Level2.monarchHook and Level2.monarchHook(myLoop)
							local spawnSpot = not mob and not goTo and not handled and nextSpawnSpot()

							if goTo and acquireHold("mobs") then
								withMover(function()
									highlightTarget(nil)
									Hold.follow = nil
									setCombatStatus("Going to " .. Level2.ZONE_NAMES[goTo] .. " for your mobs...")
									Level2.travel(goTo)
								end)
								Level2.emptySince = nil
							elseif not mob and spawnSpot and acquireHold("mobs") then
								-- Nothing alive here: wait hidden under a spawn zone so the game spawns them
								withMover(function()
									highlightTarget(nil) -- waiting at a spawn: nothing to outline yet
									Hold.follow = nil
									moveUnder(spawnSpot.part.Position)
									setCombatStatus(("No %s alive, waiting at its spawn so it spawns..."):format(spawnSpot.name))
									for _ = 1, 8 do -- up to 4s, leave as soon as a mob shows up
										task.wait(0.5)
										if not mobsRunning(myLoop) or chooseMob() then break end
									end
								end)
							elseif handled then
								task.wait(0.5)
							elseif not mob then
								releaseHold("mobs")
								setCombatStatus(problem .. "\n(waiting here in " .. Level2.ZONE_NAMES[here] .. " for respawns)")
								task.wait(2)
							elseif acquireHold("mobs") then
								withMover(function()
									highlightTarget(mob) -- outline the mob you are fighting
									equipBestSword()
									local sword = heldSword()
									local part = mobRoot(mob)
									if not (sword and part) then return end
									-- Stay 6 studs under the mob as it moves, facing up at it
									Hold.follow = function()
										if not part.Parent then return nil end
										local spot = part.Position - Vector3.new(0, MOB_DEPTH, 0)
										return CFrame.lookAt(spot, part.Position, Vector3.zAxis)
									end
									task.wait(0.4)
									local def = swordDef(sword.Name)
									local swing = (def and def.Swing or 0.5) + 0.05
									local swings = 0
									while mobsRunning(myLoop) and mob.Parent and part.Parent
										and (mob:GetAttribute("Health") or 0) > 0 and swings < 200 and heldSword() do
										local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
										if not root then break end
										setCombatStatus(("Fighting %s  HP %s/%s\nKills this session: %d"):format(
											tostring(mob:GetAttribute("Monster") or mob.Name), tostring(mob:GetAttribute("Health")),
											tostring(mob:GetAttribute("MaxHealth")), kills))
										ToolsNet.Activate.send({ Action = "Use", Look = (part.Position - root.Position).Unit })
										swings += 1
										task.wait(swing)
									end
									if (mob:GetAttribute("Health") or 0) <= 0 then kills += 1 end
									Hold.follow = nil
								end)
							else
								task.wait(1)
							end
						end
					end
				end)
			end)

			do -- Trees + Smithy block
			----------------------------------------------------------------
			-- Trees tab: auto chop trees with an axe (same idea as mining)
			-- World trees are models with TreeId / TreeKind / HP in World.Map
			-- (TreeGroup, CoconutTreeGroup, BaseIsalnd). Tested: chopping works from
			-- 6 studs under the tree's base, facing up at the trunk.
			----------------------------------------------------------------
			local TreesTab = Window:CreateTab("Trees", "tree-pine")
			Hub.tabs = Hub.tabs or {}
			Hub.tabs.Trees = TreesTab -- so the Sprouts section (made later) can sit on this tab
			local WoodConfig = require(ReplicatedStorage.Modules.Metadata.WoodcuttingConfig)

			local function axeDef(name)
				local ok, def = pcall(WoodConfig.Axe, name)
				return ok and type(def) == "table" and def or nil
			end

			local function isAxe(tool)
				return tool:IsA("Tool") and (tool:GetAttribute("ItemKind") == "Axe" or axeDef(tool.Name) ~= nil)
			end

			local function heldAxe()
				local char = LocalPlayer.Character
				local tool = char and char:FindFirstChildOfClass("Tool")
				return tool and isAxe(tool) and tool or nil
			end

			local function bestAxe()
				local best, bestPower = nil, -1
				for _, container in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
					for _, tool in ipairs(container and container:GetChildren() or {}) do
						if isAxe(tool) then
							local def = axeDef(tool.Name)
							local power = def and def.Power or 0
							if power > bestPower then best, bestPower = tool, power end
						end
					end
				end
				return best
			end

			local function equipBestAxe()
				local best, hum = bestAxe(), LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
				if best and hum and best.Parent ~= LocalPlayer.Character then hum:EquipTool(best) task.wait(0.3) end
			end

			local SelectedTrees = {}
			local ChopEveryTree = false
			local AutoEquipAxe = true -- always use your best axe

			local TreeSec = UISection(TreesTab, "Woodcutting")
			local treesPage = TreeSec.PageContainer
			local beforeTrees = {}
			for _, c in ipairs(treesPage:GetChildren()) do beforeTrees[c] = true end
			TreeSec:CreateParagraph("Woodcutting Status", "Off")
			local TreeStatus
			for _, c in ipairs(treesPage:GetChildren()) do
				if not beforeTrees[c] and c.Name == "Paragraph" then TreeStatus = c:FindFirstChild("Body", true) end
			end
			local function setTreeStatus(text)
				if TreeStatus and TreeStatus.Parent then TreeStatus.Text = text end
			end

			createSearchDropdown(TreeSec, "Trees to chop", function()
				local standing, total = {}, {}
				for _, tree in ipairs(worldTrees()) do
					local kind = tree:GetAttribute("TreeKind")
					total[kind] = (total[kind] or 0) + 1
					if (tree:GetAttribute("HP") or 0) > 0 then standing[kind] = (standing[kind] or 0) + 1 end
				end
				local items = {}
				for kind, count in pairs(total) do
					local def = type(WoodConfig.Trees) == "table" and WoodConfig.Trees[kind]
					local wood = def and type(def.Wood) == "table" and ("  |  wood %d-%d"):format(def.Wood[1], def.Wood[2]) or ""
					table.insert(items, { name = kind, detail = ("%d/%d standing%s"):format(standing[kind] or 0, count, wood) })
				end
				table.sort(items, function(a, b) return a.name < b.name end)
				return items
			end, SelectedTrees)

			TreeSec:CreateToggle("Chop Every Tree (ignore list)", function(state) ChopEveryTree = state end)

			local BadTrees = {} -- tree -> time it couldn't be hit (skipped for 60s)

			local function chooseTree()
				local any = next(SelectedTrees) ~= nil
				if not ChopEveryTree and not any then return nil, "pick some trees (or turn on Chop Every Tree)" end
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local from = root and root.Position or Vector3.zero
				local best, bestDist
				for _, tree in ipairs(worldTrees()) do
					if tree.Parent and (tree:GetAttribute("HP") or 0) > 0
						and not (BadTrees[tree] and os.clock() - BadTrees[tree] < 60)
						and (ChopEveryTree or SelectedTrees[tree:GetAttribute("TreeKind")]) then
						local d = (tree:GetPivot().Position - from).Magnitude
						if not bestDist or d < bestDist then best, bestDist = tree, d end
					end
				end
				if not best then return nil, "all your trees are chopped, waiting for them to regrow" end
				return best
			end

			local AutoChopOn = false
			local ChopLoopId = 0
			local function chopRunning(myLoop) return AutoChopOn and ChopLoopId == myLoop end

			TreeSec:CreateToggle("Auto Chop Trees", function(state)
				AutoChopOn = state
				if state then stopOtherFarms("trees") end
				ChopLoopId += 1
				if not state then
					releaseHold("trees")
					setTreeStatus("Off")
					return
				end

				local myLoop = ChopLoopId
				task.spawn(function()
					local chopped = 0
					while chopRunning(myLoop) do
						-- Only swap tools when no other feature is mid-action
						if not MoverBusy then equipBestAxe() end -- your best axe (no-op if already held)
						if not (heldAxe() or (AutoEquipAxe and bestAxe())) then
							releaseHold("trees")
							setTreeStatus("You don't have an axe")
							task.wait(1)
						else
							local tree, problem = chooseTree()
							if not tree then
								releaseHold("trees")
								setTreeStatus(problem)
								task.wait(3)
							elseif acquireHold("trees") then
								withMover(function()
									highlightTarget(tree) -- outline the tree you are chopping
									equipBestAxe()
									local axe = heldAxe()
									if not axe then return end
									-- The trunk base: the "Main" part if the tree has one, otherwise its
									-- TreeFoot point. (A tree's pivot can be up in the leaves, e.g. 13.5
									-- studs high on some Big trees, and swings from there miss.)
									local main = tree:FindFirstChild("Main")
									local foot = tree:GetAttribute("TreeFoot")
									local base = (main and main:IsA("BasePart") and main.Position)
										or (typeof(foot) == "Vector3" and tree:GetPivot():PointToWorldSpace(foot))
										or tree:GetPivot().Position
									local trunk = base + Vector3.new(0, 2, 0)
									local def = axeDef(axe.Name)
									local swing = (def and def.Swing or 0.5) + 0.05

									-- Spots to try, closest hidden spot first: 2.5 under the trunk base hits reliably
									-- (6 under was often blocked by the ground). Falls back to beside the trunk.
									local spots = {
										base - Vector3.new(0, 2.5, 0), -- just under the ground
										base + Vector3.new(3, 1.5, 0), -- beside the trunk (last resort)
									}
									local function swingOnce()
										local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
										if not root then return false end
										setTreeStatus(("Chopping %s tree  HP %s/%s\nTrees chopped this session: %d"):format(
											tostring(tree:GetAttribute("TreeKind")), tostring(tree:GetAttribute("HP")),
											tostring(tree:GetAttribute("Hits")), chopped))
										ToolsNet.Activate.send({ Action = "Use", Look = (trunk - root.Position).Unit })
										task.wait(swing)
										return true
									end
									local function standing()
										return chopRunning(myLoop) and tree.Parent and (tree:GetAttribute("HP") or 0) > 0 and heldAxe()
									end

									local hitting = false
									for _, spot in ipairs(spots) do
										if not standing() then break end
										moveUnder(spot + Vector3.new(0, UNDER_DEPTH, 0), trunk) -- facing the trunk
										task.wait(MOVE_DELAY + 0.2) -- move, settle, anchor
										local before = tree:GetAttribute("HP")
										for _ = 1, 3 do
											if not (standing() and swingOnce()) then break end
										end
										if (tree:GetAttribute("HP") or 0) < (before or 0) then hitting = true break end
									end

									if hitting then
										local swings = 0
										while standing() and swings < 150 and swingOnce() do swings += 1 end
									elseif tree.Parent and (tree:GetAttribute("HP") or 0) > 0 then
										BadTrees[tree] = os.clock() -- couldn't hit it from anywhere: skip for a minute
									end
									if (tree:GetAttribute("HP") or 0) <= 0 then chopped += 1 end
								end)
							else
								task.wait(1)
							end
						end
					end
				end)
			end)

			Hub.onShutdown(function()
				AutoChopOn = false
				ChopLoopId += 1
			end)

			----------------------------------------------------------------
			-- Smithy tab: repair tools at the Anvil, craft at the Workbench.
			-- Both only work near the station, so this moves you hidden under it.
			-- Tested: AnvilRepair(kind, toolId, material) / Craft(recipeName).
			-- Each repair material restores ~25% of a tool (Wood for wooden tools, etc).
			----------------------------------------------------------------
			local SmithyTab = Window:CreateTab("Smithy", "hammer")
			local AnvilConfig = require(ReplicatedStorage.Modules.Metadata.AnvilConfig)
			local CraftingConfig = require(ReplicatedStorage.Modules.Metadata.CraftingConfig)

			local function smithyStation(name)
				local map = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Map")
				local smithy = map and map:FindFirstChild("Shops") and map.Shops:FindFirstChild("Smithy")
				local spot = smithy and smithy:FindFirstChild(name, true)
				if not spot then return nil end
				return spot:IsA("Attachment") and spot.WorldPosition or (spot:IsA("BasePart") and spot.Position) or nil
			end

			local RepairSec = UISection(SmithyTab, "Repair")
			local smithyPage = RepairSec.PageContainer
			local beforeSmithy = {}
			for _, c in ipairs(smithyPage:GetChildren()) do beforeSmithy[c] = true end
			RepairSec:CreateParagraph("Smithy Status", "Idle")
			local SmithyStatus
			for _, c in ipairs(smithyPage:GetChildren()) do
				if not beforeSmithy[c] and c.Name == "Paragraph" then SmithyStatus = c:FindFirstChild("Body", true) end
			end
			local function setSmithyStatus(text)
				if SmithyStatus and SmithyStatus.Parent then SmithyStatus.Text = text end
			end

			-- How many of a repair material you have (Wood is a Material, ores are Ores)
			local function materialCount(material)
				local list = readData(material.Kind == "Ore" and "Ores" or "Materials")
				return type(list) == "table" and tonumber(list[material.Name]) or 0
			end

			-- Tools under the threshold (fraction of max durability) that you have material for
			local function toolsToRepair(threshold)
				local list, missing = {}, {}
				for _, container in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
					for _, tool in ipairs(container and container:GetChildren() or {}) do
						local dur, max = tool:GetAttribute("Durability"), tool:GetAttribute("MaxDurability")
						local kind, id = tool:GetAttribute("ItemKind"), tool:GetAttribute("ItemId")
						if tool:IsA("Tool") and type(dur) == "number" and type(max) == "number" and kind and id
							and dur < max * threshold then
							local ok, material = pcall(AnvilConfig.MaterialFor, tool.Name)
							if ok and type(material) == "table" then
								if materialCount(material) > 0 then
									table.insert(list, { tool = tool, kind = kind, id = id, material = material })
								else
									missing[material.Name] = true
								end
							end
						end
					end
				end
				return list, missing
			end

			local Repairing = false
			local function repairTools(threshold)
				if Repairing then return 0 end
				local list, missing = toolsToRepair(threshold)
				if #list == 0 then
					local need = {}
					for name in pairs(missing) do table.insert(need, name) end
					return 0, #need > 0 and ("need " .. table.concat(need, ", ") .. " to repair") or "nothing needs repairing"
				end
				local anvil = smithyStation("AnvilSpot")
				if not anvil and Cave.inside(Cave.myPos()) and acquireHold("smithy") then -- the Smithy is on the surface
					withMover(Cave.surface)
					anvil = smithyStation("AnvilSpot")
					if not anvil then releaseHold("smithy") end
				end
				if not anvil then return 0, "couldn't find the Anvil" end

				Repairing = true
				local repaired = 0
				if acquireHold("smithy") then
					withMover(function()
						moveUnder(anvil)
						Cave.waitSettled() -- until the server has seen you at the Anvil
						for _, item in ipairs(list) do
							if materialCount(item.material) < 1 then continue end
							local before = item.tool:GetAttribute("Durability")
							setSmithyStatus(("Repairing %s (%s/%s) with %s"):format(item.tool.Name, tostring(before),
								tostring(item.tool:GetAttribute("MaxDurability")), item.material.Name))
							RemoteManager.Fire("AnvilRepair", item.kind, item.id, item.material.Name)
							local t0 = os.clock()
							while item.tool:GetAttribute("Durability") == before and os.clock() - t0 < 1.5 do task.wait() end
							if item.tool:GetAttribute("Durability") ~= before then repaired += 1 end
						end
					end)
				end
				releaseHold("smithy")
				Repairing = false
				return repaired
			end

			RepairSec:CreateButton("Repair All Tools Now", function()
				task.spawn(function()
					local n, problem = repairTools(1) -- anything below full
					local text = n > 0 and ("Repaired %d tools"):format(n) or ("Nothing repaired: " .. tostring(problem))
					setSmithyStatus(text)
					notify("Repair", text)
				end)
			end)

			-- Auto Repair: keeps the tools your auto features use from breaking
			local AutoRepairOn = false
			local RepairLoopId = 0
			local RepairPercent = 20
			RepairSec:CreateSlider("Auto Repair Below (%)", 5, 90, 20, function(value) RepairPercent = math.floor(value) end)
			RepairSec:CreateToggle("Auto Repair", function(state)
				AutoRepairOn = state
				RepairLoopId += 1
				if not state then return end
				local myLoop = RepairLoopId
				task.spawn(function()
					while AutoRepairOn and RepairLoopId == myLoop do
						local n, problem = repairTools(RepairPercent / 100)
						if n > 0 then
							setSmithyStatus(("Auto repaired %d tools"):format(n))
						elseif problem and problem ~= "nothing needs repairing" then
							setSmithyStatus("Auto Repair: " .. problem)
						end
						for _ = 1, 5 do
							if not (AutoRepairOn and RepairLoopId == myLoop) then break end
							task.wait(1)
						end
					end
				end)
			end)

			-- Crafting
			local function recipeText(recipe)
				local parts = {}
				if recipe.Crackles then table.insert(parts, recipe.Crackles .. " crackles") end
				for _, need in ipairs(recipe.Needs or {}) do table.insert(parts, need.Count .. " " .. need.Name) end
				return table.concat(parts, ", ")
			end

			local SelectedRecipes = {}
			local CraftSec = UISection(SmithyTab, "Crafting")
			createSearchDropdown(CraftSec, "Things to craft", function()
				local items = {}
				for _, recipe in ipairs(CraftingConfig.Recipes or {}) do
					if not (CraftingConfig.Unobtainable and CraftingConfig.Unobtainable[recipe.Name]) then
						local needsBlueprint = not (CraftingConfig.NoBlueprint and CraftingConfig.NoBlueprint[recipe.Name])
						table.insert(items, { name = recipe.Name, detail = recipeText(recipe) .. (needsBlueprint and "  |  needs blueprint" or "") })
					end
				end
				return items
			end, SelectedRecipes)

			local CraftAmount = 1
			CraftSec:CreateSlider("Craft Amount (each)", 1, 10, 1, function(value) CraftAmount = math.floor(value) end)

			CraftSec:CreateButton("Craft Picked Now", function()
				task.spawn(function()
					local picked = {}
					for name in pairs(SelectedRecipes) do table.insert(picked, name) end
					table.sort(picked)
					if #picked == 0 then notify("Craft", "Pick something in Things to craft first") return end
					local bench = smithyStation("CraftSpot")
					if not bench and Cave.inside(Cave.myPos()) and acquireHold("smithy") then -- the Smithy is on the surface
						withMover(Cave.surface)
						bench = smithyStation("CraftSpot")
						if not bench then releaseHold("smithy") end
					end
					if not bench then notify("Craft", "Couldn't find the Workbench") return end
					local crafted = 0
					if acquireHold("smithy") then
						withMover(function()
							moveUnder(bench)
							Cave.waitSettled() -- until the server has seen you at the Workbench
							for _, name in ipairs(picked) do
								for _ = 1, CraftAmount do
									-- a craft spends crackles and/or materials, so watch all of them
									local function spent()
										local d = LocalPlayer.Data
										return tostring(d.Crackles.Value) .. (d:FindFirstChild("Materials") and d.Materials.Value or "")
											.. (d:FindFirstChild("Ores") and d.Ores.Value or "")
									end
									local before = spent()
									setSmithyStatus("Crafting " .. name)
									RemoteManager.Fire("Craft", name)
									local t0 = os.clock()
									while spent() == before and os.clock() - t0 < 1.5 do task.wait() end
									if spent() == before then break end -- couldn't afford / missing blueprint
									crafted += 1
								end
							end
						end)
					end
					releaseHold("smithy")
					local text = crafted > 0 and ("Crafted %d items"):format(crafted) or "Nothing crafted (not enough crackles / materials, or missing blueprint)"
					setSmithyStatus(text)
					notify("Craft", text)
				end)
			end)

			Hub.onShutdown(function()
				AutoRepairOn = false
				RepairLoopId += 1
			end)
			registerFarm("trees", TreesTab, "Auto Chop Trees", function() return AutoChopOn end)
			end -- Trees + Smithy block (own scope: Luau allows 200 locals per function)

			do -- Fishing block (own scope: Luau allows 200 locals per function)
			----------------------------------------------------------------
			-- Fishing tab: auto fish. Tested flow: Cast(water spot) -> the game's
			-- FishingVFX "Bite" for you -> Hook -> wait the fastest allowed reel
			-- (FishingConfig.FastestReel, ~2.2s) -> Reel(Caught = true) -> fish caught.
			-- Fishes where you stand if there's water within 40 studs, otherwise at
			-- the fisher NPC (Fuso) spot. Uses the game's own cast so you see the
			-- animation, line and bobber.
			----------------------------------------------------------------
			local FishingTab = Window:CreateTab("Fishing", "fish")
			local FishingConfig = require(ReplicatedStorage.Modules.Metadata.FishingConfig)
			local VFXModule = require(ReplicatedStorage.Modules.Effects.VFX)

			-- Listen to the game's own fishing events for you (the originals still run)
			local FishEvents = {} -- name -> { id, data, at } of the latest event for you
			local fishOriginals = {}
			local fishHandlers = VFXModule.Modules and VFXModule.Modules.FishingVFX
			if fishHandlers then
				for _, name in ipairs({ "Cast", "Bite", "Reel", "Lost", "Caught", "Stop", "Escape" }) do
					local original = fishHandlers[name]
					if type(original) == "function" then
						fishOriginals[name] = original
						fishHandlers[name] = function(data, ...)
							if type(data) == "table" and data.Player == LocalPlayer then
								FishEvents[name] = { id = data.Id, data = data, at = os.clock() }
							end
							return original(data, ...)
						end
					end
				end
			end

			-- The game's own cast function (plays the cast animation + line + bobber).
			-- Found once by its "FishCast" animation; if it can't be found we send the
			-- cast ourselves (works the same, you just don't see the throw).
			local gameCast
			pcall(function()
				for _, fn in ipairs(getgc(false)) do
					if type(fn) == "function" and islclosure(fn) then
						local okSrc, src = pcall(debug.info, fn, "s")
						if okSrc and tostring(src):find("FishingController") then
							local okK, consts = pcall(debug.getconstants, fn)
							if okK and type(consts) == "table" then
								local hasCast, hasAnim = false, false
								for _, k in pairs(consts) do
									if k == "Cast" then hasCast = true end
									if k == "FishCast" then hasAnim = true end
								end
								if hasCast and hasAnim then gameCast = fn break end
							end
						end
					end
				end
			end)

			local fishSec = UISection(FishingTab, "Auto Fishing")
			local beforeFish = {}
			for _, c in ipairs(fishSec.PageContainer:GetChildren()) do beforeFish[c] = true end
			fishSec:CreateParagraph("Fishing Status", "Off")
			local FishStatus
			for _, c in ipairs(fishSec.PageContainer:GetChildren()) do
				if not beforeFish[c] and c.Name == "Paragraph" then FishStatus = c:FindFirstChild("Body", true) end
			end
			local function setFishStatus(text)
				if FishStatus and FishStatus.Parent then FishStatus.Text = text end
			end

			local function isRod(tool)
				return tool:IsA("Tool") and tool:GetAttribute("ItemKind") == "Rod"
			end
			local function heldRod()
				local char = LocalPlayer.Character
				local tool = char and char:FindFirstChildOfClass("Tool")
				return tool and isRod(tool) and tool or nil
			end
			local function bestRod()
				local best, bestOrder = nil, -1
				for _, container in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
					for _, tool in ipairs(container and container:GetChildren() or {}) do
						if isRod(tool) then
							local ok, def = pcall(FishingConfig.Rod, tool.Name)
							local order = ok and type(def) == "table" and (def.Order or def.Power or 0) or 0
							if order > bestOrder then best, bestOrder = tool, order end
						end
					end
				end
				return best
			end

			-- Water to cast at: open water within 40 studs of a point (raycast down)
			local function waterNear(point)
				local params = RaycastParams.new()
				params.FilterDescendantsInstances = { LocalPlayer.Character }
				for radius = 8, 40, 4 do
					for angle = 0, 330, 30 do
						local from = point + Vector3.new(math.cos(math.rad(angle)) * radius, 30, math.sin(math.rad(angle)) * radius)
						local hit = workspace:Raycast(from, Vector3.new(0, -80, 0), params)
						if hit and (hit.Instance.Name == "Surface" or hit.Material == Enum.Material.Water) then return hit.Position end
					end
				end
				return nil
			end

			local function findFishingSpot()
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if root then
					local water = waterNear(root.Position)
					if water then return { stand = root.Position, water = water } end
				end
				local npcs = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("NPCs")
				local fisher = npcs and npcs:FindFirstChild("Fuso")
				if fisher then
					local base = fisher:GetPivot().Position
					local water = waterNear(base)
					if water then
						local toWater = ((water - base) * Vector3.new(1, 0, 1)).Unit
						return { stand = base + toWater * 6, water = water }
					end
				end
				return nil
			end

			local AutoEquipRod = true -- always use your best rod

			local AutoFishOn = false
			local FishLoopId = 0
			local castId = 50000
			local function fishRunning(myLoop) return AutoFishOn and FishLoopId == myLoop end

			-- Waits for one of the game's fishing events for you; returns its name and data
			local function waitFor(names, since, timeout, myLoop)
				local t0 = os.clock()
				while fishRunning(myLoop) and os.clock() - t0 < timeout do
					for _, name in ipairs(names) do
						local e = FishEvents[name]
						if e and e.at >= since then return name, e end
					end
					task.wait(0.05)
				end
				return nil
			end

			local function cast(target)
				if gameCast then
					local ok = pcall(gameCast, target)
					if ok then return end
				end
				castId += 1
				ToolsNet.Fishing.send({ Action = "Cast", Target = target, Id = castId })
			end

			fishSec:CreateToggle("Auto Fish", function(state)
				AutoFishOn = state
				if state then stopOtherFarms("fish") end
				FishLoopId += 1
				if not state then
					pcall(function() ToolsNet.Fishing.send({ Action = "Stop" }) end)
					releaseHold("fish")
					setFishStatus("Off")
					return
				end

				local myLoop = FishLoopId
				task.spawn(function()
					local spot = findFishingSpot()
					local caught, lost = 0, 0
					local ok, fastest = pcall(FishingConfig.FastestReel)
					if not ok or type(fastest) ~= "number" then fastest = 2.2 end
					while fishRunning(myLoop) do
						if not MoverBusy then -- always your best rod
							local best, hum = bestRod(), LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
							if best and hum and best.Parent ~= LocalPlayer.Character then hum:EquipTool(best) task.wait(0.4) end
						end
						if not heldRod() then
							setFishStatus("You don't have a fishing rod")
							task.wait(1)
						elseif not spot then
							setFishStatus("Couldn't find water nearby or at the fisher spot")
							task.wait(3)
							spot = findFishingSpot()
						elseif acquireHold("fish") then
							withMover(function()
								-- stand at the spot facing the water (fishing needs you above ground)
								local face = CFrame.lookAt(spot.stand, Vector3.new(spot.water.X, spot.stand.Y, spot.water.Z))
								if not Hold.target or (Hold.target.Position - face.Position).Magnitude > 0.5 then
									Hold.settleAt = os.clock() + SETTLE_TIME
								end
								Hold.target = face
								highlightTarget(nil)
								while os.clock() < (Hold.settleAt or 0) do task.wait() end

								local since = os.clock()
								setFishStatus(("Casting...  |  caught %d, lost %d"):format(caught, lost))
								cast(spot.water)
								local got = waitFor({ "Bite", "Stop", "Lost" }, since, 45, myLoop)
								if got ~= "Bite" then return end
								ToolsNet.Fishing.send({ Action = "Hook" })
								setFishStatus(("Reeling in...  |  caught %d, lost %d"):format(caught, lost))
								waitFor({ "Reel", "Lost" }, since, 5, myLoop)
								task.wait(fastest + 0.15) -- the fastest reel the game allows
								if not fishRunning(myLoop) then return end
								ToolsNet.Fishing.send({ Action = "Reel", Caught = true })
								local result, e = waitFor({ "Caught", "Lost" }, since, 5, myLoop)
								if result == "Caught" then
									caught += 1
									setFishStatus(("Caught %s (%s kg)  |  caught %d, lost %d"):format(tostring(e.data.Fish),
										tostring(e.data.Weight), caught, lost))
								else
									lost += 1
								end
							end)
							task.wait(0.3)
						else
							task.wait(1)
						end
					end
				end)
			end)

			registerFarm("fish", FishingTab, "Auto Fish", function() return AutoFishOn end)

			Hub.onShutdown(function()
				AutoFishOn = false
				FishLoopId += 1
				if fishHandlers then
					for name, original in pairs(fishOriginals) do fishHandlers[name] = original end
				end
			end)
			end -- Fishing block

			do -- Monarch Shards block (own scope)
			----------------------------------------------------------------
			-- Monarch Shards + Slate Monarch summon.
			-- Shards lie on the Deepslate floor (workspace.World.RitualShards.ShardPickup),
			-- each with a "Take Monarch Shard" prompt (10 stud range). You own them as
			-- Data.Materials["Monarch Shard"]. The altar is Map.Level2Cave.MonarchAltar
			-- (attributes State / Placed): with 8+ shards, go there and use its prompt.
			----------------------------------------------------------------
			local SHARDS_TO_SUMMON = 8
			local shardSec = UISection(CombatTab, "Monarch Shards")
			local beforeShard = {}
			for _, c in ipairs(shardSec.PageContainer:GetChildren()) do beforeShard[c] = true end
			shardSec:CreateParagraph("Shard Status", "Off")
			local ShardStatus
			for _, c in ipairs(shardSec.PageContainer:GetChildren()) do
				if not beforeShard[c] and c.Name == "Paragraph" then ShardStatus = c:FindFirstChild("Body", true) end
			end
			local function setShardStatus(text)
				if ShardStatus and ShardStatus.Parent then ShardStatus.Text = text end
			end

			local function shardCount()
				local materials = readData("Materials")
				return type(materials) == "table" and tonumber(materials["Monarch Shard"]) or 0
			end

			local function shardPrompts()
				local list = {}
				local folder = workspace.World:FindFirstChild("RitualShards")
				for _, shard in ipairs(folder and folder:GetChildren() or {}) do
					for _, d in ipairs(shard:GetDescendants()) do
						if d:IsA("ProximityPrompt") and d.Enabled then
							table.insert(list, { shard = shard, prompt = d })
							break
						end
					end
				end
				return list
			end

			local function takePrompt(prompt)
				pcall(function() prompt.RequiresLineOfSight = false end)
				if typeof(fireproximityprompt) == "function" then
					pcall(fireproximityprompt, prompt)
					task.wait(0.25)
					if not (prompt.Parent and prompt.Enabled) then return end
				end
				-- fallback: hold the prompt like a player would
				pcall(function() prompt:InputHoldBegin() task.wait(prompt.HoldDuration + 0.1) prompt:InputHoldEnd() end)
			end

			local shardsTaken = 0
			local function status(text)
				setShardStatus(("%s\nYou have %d Monarch Shards  |  taken this session %d"):format(text, shardCount(), shardsTaken))
			end

			-- One pass: take every loaded shard; if none are loaded, go down to the
			-- Deepslate floor (leaving and re-entering the cave if you're already there)
			local function shardPass(user, keepGoing)
				local list = shardPrompts()
				if not acquireHold(user) then return end
				withMover(function()
					if #list == 0 then
						if Level2.inside(Cave.myPos()) then
							status("No shards left here, leaving the cave and coming back...")
							Cave.surface()
						end
						status("Going to the Deepslate floor for shards...")
						Cave.enter()
						local center = Level2.center()
						if center then moveUnder(center + Vector3.new(0, UNDER_DEPTH, 0)) end
						task.wait(3) -- let the floor and its shards load
						list = shardPrompts()
					end
					for _, item in ipairs(list) do
						if not keepGoing() then return end
						if item.shard.Parent and item.prompt.Enabled then
							local pos = item.shard:GetPivot().Position
							highlightTarget(item.shard)
							-- The prompt needs line of sight, so it can't be used from under
							-- the floor: stand right beside the shard, above ground, facing it.
							local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
							local far = not root or (root.Position - pos).Magnitude > 80
							Hold.follow = nil
							Hold.target = CFrame.lookAt(pos + Vector3.new(2.5, 3, 0), pos)
							Hold.settleAt = os.clock() + (far and 1.2 or SETTLE_TIME)
							Cave.waitSettled()
							for _ = 1, 4 do
								if not (item.shard.Parent and item.prompt.Parent and item.prompt.Enabled) then break end
								takePrompt(item.prompt)
								task.wait(0.5)
							end
							if not item.shard.Parent or not item.prompt.Parent or not item.prompt.Enabled then shardsTaken += 1 end
							status("Collecting shards...")
						end
					end
					highlightTarget(nil)
				end)
			end

			-- Go to the Monarch altar and use its prompt (places your shards / summons)
			local function summonAtAltar(keepGoing)
				Cave.enter()
				local cave = workspace.World:FindFirstChild("Map") and workspace.World.Map:FindFirstChild("Level2Cave")
				local altar = cave and cave:FindFirstChild("MonarchAltar")
				if not altar then
					local center = Level2.center()
					if center then moveUnder(center + Vector3.new(0, UNDER_DEPTH, 0)) task.wait(3) end
					altar = cave and cave:FindFirstChild("MonarchAltar")
				end
				if not altar then status("Couldn't find the Monarch altar") return end
				local pos = altar:GetPivot().Position
				highlightTarget(altar)
				Hold.follow = nil
				local used = false
				local function useAltar()
					for _, d in ipairs(altar:GetDescendants()) do
						if d:IsA("ProximityPrompt") and d.Enabled then
							takePrompt(d)
							used = true
						end
					end
				end
				local function summoned() return altar:GetAttribute("State") ~= "Waiting" end
				local function hide() -- safe spot: hidden under the altar
					moveUnder(pos, pos)
					task.wait(MOVE_DELAY)
				end

				-- 1) try from the safe spot under the altar first
				status("Under the altar, summoning the Slate Monarch...")
				hide()
				for _ = 1, 4 do
					if not keepGoing() or summoned() then break end
					useAltar()
					task.wait(0.5)
				end
				-- 2) still waiting: step out beside it for a moment, use it, and go straight back under
				local tries = 0
				while keepGoing() and not summoned() and tries < 6 do
					tries += 1
					Hold.target = CFrame.lookAt(pos + Vector3.new(5, 3, 0), pos)
					Hold.settleAt = os.clock() + SETTLE_TIME
					task.wait(SETTLE_TIME + 0.1)
					useAltar()
					hide() -- never stand still out in the open
					task.wait(0.5)
				end
				hide() -- stay hidden while the Monarch rises
				highlightTarget(nil)
				if not used then
					status("No summon prompt showed up on the altar")
				else
					status(("Altar: %s (placed %s)"):format(tostring(altar:GetAttribute("State")), tostring(altar:GetAttribute("Placed"))))
				end
			end

			-- Called by Auto Farm Mobs when Slate Monarch is picked and none is alive.
			-- Returns true when it took care of things (so the mob farm waits).
			Level2.monarchHook = function()
				if not SelectedMobs["Slate Monarch"] then return false end
				local keep = function() return AutoMobsOn end
				if shardCount() >= SHARDS_TO_SUMMON then
					if acquireHold("mobs") then withMover(function() summonAtAltar(keep) end) end
					task.wait(3) -- give the Monarch a moment to rise
				else
					shardPass("mobs", keep)
				end
				return true
			end

			local AutoShardsOn = false
			local ShardLoopId = 0
			shardSec:CreateToggle("Auto Collect Monarch Shards", function(state)
				AutoShardsOn = state
				ShardLoopId += 1
				if not state then
					releaseHold("shards")
					setShardStatus("Off")
					return
				end
				local myLoop = ShardLoopId
				local keep = function() return AutoShardsOn and ShardLoopId == myLoop end
				task.spawn(function()
					while keep() do
						shardPass("shards", keep)
						if #shardPrompts() == 0 then task.wait(5) else task.wait(1) end
					end
				end)
			end)

			Hub.onShutdown(function()
				AutoShardsOn = false
				ShardLoopId += 1
				Level2.monarchHook = nil
			end)
			end -- Monarch Shards block

			do -- Sprouts block (own scope)
			----------------------------------------------------------------
			-- Auto Sprout: sprouts pop up around the map (workspace.World.Sprouts),
			-- each with Health / State = "Ready" and AllTools = true, so a sword hits
			-- them. Like the tree farm: go hidden just under it, face up, swing your
			-- sword until it breaks, then wait hidden for the next one.
			----------------------------------------------------------------
			local sproutSec = UISection((Hub.tabs and Hub.tabs.Trees) or CombatTab, "Sprouts") -- lives on the Trees tab
			local beforeSprout = {}
			for _, c in ipairs(sproutSec.PageContainer:GetChildren()) do beforeSprout[c] = true end
			sproutSec:CreateParagraph("Sprout Status", "Off")
			local SproutStatus
			for _, c in ipairs(sproutSec.PageContainer:GetChildren()) do
				if not beforeSprout[c] and c.Name == "Paragraph" then SproutStatus = c:FindFirstChild("Body", true) end
			end
			local function setSproutStatus(text)
				if SproutStatus and SproutStatus.Parent then SproutStatus.Text = text end
			end

			local function readySprout()
				local folder = workspace.World:FindFirstChild("Sprouts")
				local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				local best, bestDist
				for _, sprout in ipairs(folder and folder:GetChildren() or {}) do
					if sprout:IsA("Model") and sprout:GetAttribute("State") == "Ready" and (sprout:GetAttribute("Health") or 0) > 0 then
						local d = root and (sprout:GetPivot().Position - root.Position).Magnitude or 0
						if not bestDist or d < bestDist then best, bestDist = sprout, d end
					end
				end
				return best
			end

			local AutoSproutOn = false
			local SproutLoopId = 0
			local sproutsBroken = 0
			local SPROUT_DEPTH = 5.5 -- same reach as the mob farm

			sproutSec:CreateToggle("Auto Sprout", function(state)
				AutoSproutOn = state
				SproutLoopId += 1
				if not state then
					releaseHold("sprout")
					setSproutStatus("Off")
					return
				end
				local myLoop = SproutLoopId
				local function running() return AutoSproutOn and SproutLoopId == myLoop end
				task.spawn(function()
					while running() do
						local sprout = readySprout()
						if not sprout then
							releaseHold("sprout")
							setSproutStatus(("Waiting for a sprout to appear...  |  broken %d"):format(sproutsBroken))
							task.wait(2)
						elseif acquireHold("sprout") then
							withMover(function()
								-- any sword works on sprouts; use your best one if you hold none
								equipBestSword()
								local sword = heldSword()
								if not sword then setSproutStatus("You need a sword for sprouts") task.wait(2) return end
								local pos = sprout:GetPivot().Position
								highlightTarget(sprout)
								moveUnder(pos + Vector3.new(0, UNDER_DEPTH - SPROUT_DEPTH, 0), pos) -- hidden, facing up
								task.wait(MOVE_DELAY)
								local def = swordDef(sword.Name)
								local swing = (def and def.Swing or 0.5) + 0.05
								local swings = 0
								while running() and sprout.Parent and sprout:GetAttribute("State") == "Ready"
									and (sprout:GetAttribute("Health") or 0) > 0 and swings < 300 and heldSword() do
									local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
									if not root then break end
									setSproutStatus(("Hitting %s  HP %s/%s  |  broken %d"):format(sprout.Name,
										tostring(sprout:GetAttribute("Health")), tostring(sprout:GetAttribute("MaxHealth")), sproutsBroken))
									ToolsNet.Activate.send({ Action = "Use", Look = (pos - root.Position).Unit })
									swings += 1
									task.wait(swing)
								end
								if not sprout.Parent or (sprout:GetAttribute("Health") or 0) <= 0 then
									sproutsBroken += 1
									setSproutStatus(("Broke it! Grabbing the loot...  |  broken %d"):format(sproutsBroken))
									task.wait(2.5) -- stay close a moment so the dropped loot flies to you
								end
								highlightTarget(nil)
							end)
							task.wait(0.3)
						else
							task.wait(1)
						end
					end
				end)
			end)

			Hub.onShutdown(function()
				AutoSproutOn = false
				SproutLoopId += 1
			end)
			end -- Sprouts block

			-- The moving farms (only one runs at a time)
			registerFarm("harvest", AutoFarmTab, "Auto Harvest (all gardens)", function() return AutoHarvestOn end)
			registerFarm("mine", MiningTab, "Auto Mine", function() return AutoMineOn end)
			registerFarm("mobs", CombatTab, "Auto Farm Mobs", function() return AutoMobsOn end)

			do -- Leaderboard climber block (own scope)
			----------------------------------------------------------------
			-- Leaderboard tab: climbs the game's 5 boards (Crackles, Crops, Eggs,
			-- Fish, Monsters) until you're at the place you picked or better.
			-- Boards: ReplicatedStorage.LeaderboardLists.<Board>_Daily / _All
			-- (JSON top 50 of {u = userId, n = name, v = value}). Your own counts:
			-- Data.Stats (T = today, A = all time).
			-- Moving farms take turns (Fish -> Auto Fish, Monsters -> Auto Farm Mobs,
			-- Crops / Crackles -> Auto Harvest), switching every few minutes between
			-- the boards you're still behind on. Helpers run alongside: Auto Plant
			-- (crops), selling just enough for the Crackles board (never everything),
			-- and Eggs: auto buy
			-- from the egg shop + hatch the eggs you own (hatched pets go to your bag).
			----------------------------------------------------------------
			local LBTab = Window:CreateTab("Leaderboard", "trophy")
			local LBConfig
			pcall(function() LBConfig = require(ReplicatedStorage.Modules.Metadata.LeaderboardConfig) end)
			local BOARDS = { "Fish", "Monsters", "Crops", "Crackles", "Eggs" }
			local FARM_OF = { Fish = "fish", Monsters = "mobs", Crops = "harvest", Crackles = "harvest" }
			local Climb = { on = false, loopId = 0, place = 3, allTime = false, slice = 3, current = nil, since = 0, started = {} }

			local function commas(n)
				local s = tostring(math.floor((tonumber(n) or 0) + 0.5))
				return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
			end

			local function boardEntries(id)
				local folder = ReplicatedStorage:FindFirstChild("LeaderboardLists")
				local value = folder and folder:FindFirstChild(id .. (Climb.allTime and "_All" or "_Daily"))
				if not value then return {} end
				local ok, list = pcall(HttpService.JSONDecode, HttpService, value.Value)
				return ok and type(list) == "table" and list or {}
			end

			local function myCount(id)
				local stats = readData("Stats")
				if type(stats) ~= "table" then return 0 end
				if Climb.allTime then return tonumber(stats.A and stats.A[id]) or 0 end
				-- today's counts are only valid for today
				if LBConfig and LBConfig.Day and stats.Day then
					local ok, today = pcall(LBConfig.Day)
					if ok and tonumber(today) and tonumber(today) ~= tonumber(stats.Day) then return 0 end
				end
				return tonumber(stats.T and stats.T[id]) or 0
			end

			-- Your place now, and how much you need to sit at the picked place
			local function boardInfo(id)
				local mine = myCount(id)
				local others = {}
				local list = boardEntries(id)
				for _, e in ipairs(list) do
					if tonumber(e.u) ~= LocalPlayer.UserId then table.insert(others, tonumber(e.v) or 0) end
				end
				table.sort(others, function(a, b) return a > b end)
				local place = 1
				for _, v in ipairs(others) do if v >= mine then place += 1 end end
				local rival = others[Climb.place] -- whoever holds the picked place (without you)
				local goal = rival and (rival + 1) or 1
				return {
					mine = mine, place = place, goal = goal, gap = math.max(0, goal - mine),
					offBoard = #list >= 50 and place > #others, -- below the shown top 50
				}
			end

			-- Toggle helpers: turn a hub toggle on/off by its title (state from the saved config)
			local function setToggle(tab, title, key, want)
				if (Config.get(key) == true) == want then return false end
				local frame = findToggle(tab, title)
				if frame and frame:FindFirstChild("ToggleInvisibleClick") then
					pressButton(frame.ToggleInvisibleClick)
					return true
				end
				return false
			end
			local function setFarm(name, want)
				local farm = MovingFarms[name]
				if not (farm and farm.frame and farm.frame.Parent) then return false end
				if farm.isOn() == want then return false end
				pressButton(farm.frame.ToggleInvisibleClick)
				return true
			end

			local HELPERS = {
				plant = { tab = AutoFarmTab, title = "Auto Plant", key = "AutoFarm/toggle/Auto Plant" },
				sell = { tab = ExtrasTab, title = "Auto Sell Crops & Pet Drops", key = "Extras/toggle/Auto Sell Crops & Pet Drops" },
				eggs = { tab = ShopTab, title = "Auto Buy Picked Eggs", key = "Shop/toggle/Auto Buy Picked Eggs" },
			}
			local function helper(name, want)
				local h = HELPERS[name]
				if setToggle(h.tab, h.title, h.key, want) and want then Climb.started["helper:" .. name] = true end
			end

			local function anyGardenSet()
				for _, settings in pairs(Gardens) do
					if settings.Enabled and settings.Crop then return true end
				end
				return false
			end

			-- Eggs: hatch every egg you own. Tested: hold the egg tool (attribute Egg)
			-- and fire PlaceEgg(petPen, x, z) -> hatched instantly (InstantHatch), the pet
			-- goes to your bag even when the pen is full; Stats.T.Eggs 50 -> 51.
			-- Goes next to pet pen 1 first (the pen is on the surface), then gives you
			-- back whatever tool you were holding.
			local hatchedThisSession = 0
			local function eggTool(name)
				for _, container in ipairs({ LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }) do
					for _, tool in ipairs(container and container:GetChildren() or {}) do
						if tool:IsA("Tool") and tool:GetAttribute("Egg") and tool.Name == name then return tool end
					end
				end
			end
			local function eggCount(name)
				local eggs = readData("Eggs")
				return type(eggs) == "table" and tonumber(eggs[name]) or 0
			end
			-- Hatches only `limit` eggs (just enough for your target), cheapest kind first
			local EGG_ORDER = { ["Basic Egg"] = 1, ["Silver Egg"] = 2, ["Golden Egg"] = 3, ["Diamond Egg"] = 4 }
			local function hatchEggs(limit)
				if not limit or limit <= 0 then return 0 end
				local eggs = readData("Eggs")
				local todo = {}
				for name, count in pairs(type(eggs) == "table" and eggs or {}) do
					if (tonumber(count) or 0) > 0 then table.insert(todo, name) end
				end
				if #todo == 0 then return 0 end
				table.sort(todo, function(a, b)
					local ra, rb = EGG_ORDER[a] or (a:find("Blessed") and 9 or 5), EGG_ORDER[b] or (b:find("Blessed") and 9 or 5)
					if ra ~= rb then return ra < rb end
					return a < b
				end)
				local pen = myPen(1)
				local floor = pen and pen:GetAttribute("Floor")
				if typeof(floor) ~= "CFrame" or not acquireHold("eggs") then return 0 end
				local done = 0
				withMover(function()
					if Cave.inside(Cave.myPos()) then Cave.surface() end
					moveUnder(floor.Position + Vector3.new(0, UNDER_DEPTH - 4, 0), floor.Position)
					Cave.waitSettled()
					local char = LocalPlayer.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not hum then return end
					local previous = char:FindFirstChildOfClass("Tool")
					for _, name in ipairs(todo) do
						local tool = done < limit and eggTool(name)
						if tool then
							if tool.Parent ~= char then hum:EquipTool(tool) task.wait(0.3) end
							local fails = 0
							while Climb.on and done < limit and eggCount(name) > 0 and fails < 3 do
								local before = eggCount(name)
								-- a spot inside pen 1 (same kind of spot the game sends)
								RemoteManager.Fire("PlaceEgg", 1, 14 + math.random() * 1.2, math.random(-9, 1) + math.random())
								local t0 = os.clock()
								while eggCount(name) == before and os.clock() - t0 < 1.5 do task.wait(0.05) end
								if eggCount(name) < before then
									done += 1
									hatchedThisSession += 1
									fails = 0
								else
									fails += 1
								end
								if not (tool.Parent == char) then
									tool = eggTool(name)
									if not tool then break end
									hum:EquipTool(tool)
									task.wait(0.3)
								end
							end
						end
					end
					if previous and previous.Parent and previous.Parent ~= char then
						hum:EquipTool(previous)
					elseif not previous then
						hum:UnequipTools()
					end
				end)
				releaseHold("eggs")
				return done
			end
			Climb.hatchOne = true

			local ClimbSec = UISection(LBTab, "Climb the Leaderboards")
			local beforeLB = {}
			for _, c in ipairs(ClimbSec.PageContainer:GetChildren()) do beforeLB[c] = true end
			ClimbSec:CreateParagraph("Leaderboards", "Loading...")
			local LBBody
			for _, c in ipairs(ClimbSec.PageContainer:GetChildren()) do
				if not beforeLB[c] and c.Name == "Paragraph" then LBBody = c:FindFirstChild("Body", true) end
			end

			ClimbSec:CreateSlider("Place I Want (or better)", 1, 10, 3, function(value) Climb.place = math.floor(value) end)
			ClimbSec:CreateSlider("Switch Farm Every (minutes)", 1, 15, 3, function(value) Climb.slice = math.floor(value) end)
			ClimbSec:CreateToggle("Use All-Time Boards (off = Daily)", function(state) Climb.allTime = state end)

			local function statusText()
				local lines = { ("Target: #%d or better on the %s boards"):format(Climb.place, Climb.allTime and "all-time" or "daily") }
				for _, id in ipairs(BOARDS) do
					local info = boardInfo(id)
					local placeText = info.offBoard and "50+" or ("#" .. info.place)
					local mark = info.gap == 0 and "✓" or ("need %s more"):format(commas(info.gap))
					table.insert(lines, ("%s: %s (%s)  |  %s"):format(id, commas(info.mine), placeText, mark))
				end
				if Climb.on then
					table.insert(lines, "")
					table.insert(lines, Climb.note or "Working...")
				end
				return table.concat(lines, "\n")
			end

			-- Monsters board: farm the quick cave level 1 mobs. Your own picks are
			-- kept aside and put back when the climber is done with Monsters.
			-- (names as the mob farm knows them: all cave level 1, so it goes into the cave)
			local CLIMB_MOBS = { "Moss Beetle", "Mossling", "Mushroom", "Slime", "Spider" }
			local savedMobs
			local function useClimbMobs()
				if savedMobs then return end
				savedMobs = {}
				for name, on in pairs(SelectedMobs) do savedMobs[name] = on end
				table.clear(SelectedMobs)
				for _, name in ipairs(CLIMB_MOBS) do SelectedMobs[name] = true end
			end
			local function restoreMobs()
				if not savedMobs then return end
				table.clear(SelectedMobs)
				for name, on in pairs(savedMobs) do SelectedMobs[name] = on end
				savedMobs = nil
			end

			local function stopEverythingWeStarted()
				restoreMobs()
				for key in pairs(Climb.started) do
					local farm = key:match("^farm:(.+)$")
					local help = key:match("^helper:(.+)$")
					if farm then setFarm(farm, false) end
					if help then helper(help, false) end
				end
				Climb.started = {}
				Climb.current = nil
			end

			ClimbSec:CreateToggle("Auto Climb Leaderboards", function(state)
				Climb.on = state
				Climb.loopId += 1
				if not state then
					stopEverythingWeStarted()
					Climb.note = nil
					return
				end
				local myLoop = Climb.loopId
				local function running() return Climb.on and Climb.loopId == myLoop end
				task.spawn(function()
					local lastHatch = 0
					while running() do
						local info = {}
						for _, id in ipairs(BOARDS) do info[id] = boardInfo(id) end
						local notes = {}

						-- helpers that run alongside the moving farm
						local cropsBehind = info.Crops.gap > 0 or info.Crackles.gap > 0
						if cropsBehind then
							if anyGardenSet() then helper("plant", true) else table.insert(notes, "Pick a crop for a garden on the Farm tab so it can replant") end
						end
						-- Crackles: sell only what's still needed for your place (e.g. #9 has
						-- 600k and you're at 0 -> sell about 600k worth, never everything)
						if info.Crackles.gap > 0 and Hub.planForAmount and os.clock() - (Climb.lastSell or 0) > 30 then
							Climb.lastSell = os.clock()
							local items, value = Hub.planForAmount(info.Crackles.gap)
							if not items and (value or 0) > 0 and Hub.valuedStacks then
								-- not enough to cover it yet: everything you have is still needed
								items = {}
								for _, s in ipairs(Hub.valuedStacks()) do table.insert(items, { s.name, s.count }) end
							end
							if items and #items > 0 then
								local earned = sellNow(items)
								if earned then Climb.soldNote = ("Sold %s Crackles worth for the Crackles board"):format(commas(earned)) end
							end
						end
						if Climb.soldNote then table.insert(notes, Climb.soldNote) end
						if info.Eggs.gap > 0 then
							local eggShop = Shops[2]
							if eggShop and next(eggShop.selected) == nil then
								-- nothing picked: pick every egg so it buys whatever is in stock
								for _, name in ipairs(eggShop.config.List()) do eggShop.selected[name] = true end
								pcall(function() eggShop.dropdown.refresh() end)
							end
							helper("eggs", true)
							if os.clock() - lastHatch > 10 then
								lastHatch = os.clock()
								if Climb.hatchOne then
									hatchEggs(info.Eggs.gap) -- only what you still need for your place
								else
									table.insert(notes, "Egg hatching isn't set up yet (buying eggs only)")
								end
							end
						end

						-- the moving farm: take turns between the boards you're behind on
						local wanted, seen = {}, {}
						for _, id in ipairs(BOARDS) do
							local farm = FARM_OF[id]
							if farm and info[id].gap > 0 and not seen[farm] then
								seen[farm] = true
								table.insert(wanted, farm)
							end
						end
						if #wanted == 0 then
							if Climb.current then setFarm(Climb.current, false) Climb.current = nil end
							restoreMobs()
							table.insert(notes, 1, ("You're #%d or better everywhere I can farm. Keeping watch..."):format(Climb.place))
						else
							local keep = Climb.current and seen[Climb.current]
								and (#wanted == 1 or os.clock() - Climb.since < Climb.slice * 60)
							if not keep then
								-- next farm after the current one, in board order
								local nextFarm = wanted[1]
								for i, farm in ipairs(wanted) do
									if farm == Climb.current then nextFarm = wanted[i % #wanted + 1] break end
								end
								Climb.current = nextFarm
								Climb.since = os.clock()
							end
							if Climb.current == "mobs" then useClimbMobs() else restoreMobs() end
							if setFarm(Climb.current, true) then Climb.started["farm:" .. Climb.current] = true end
							local names = { fish = "Auto Fish", mobs = "Auto Farm Mobs", harvest = "Auto Harvest" }
							local left = math.max(0, Climb.slice * 60 - (os.clock() - Climb.since))
							table.insert(notes, 1, ("Now: %s%s"):format(names[Climb.current] or Climb.current,
								#wanted > 1 and (" (switching in %dm %ds)"):format(left // 60, left % 60) or ""))
						end
						if hatchedThisSession > 0 then table.insert(notes, ("Hatched %d eggs this session"):format(hatchedThisSession)) end
						Climb.note = table.concat(notes, "\n")
						for _ = 1, 5 do
							if not running() then break end
							task.wait(1)
						end
					end
				end)
			end)

			local LBOn = true
			task.spawn(function()
				while LBOn do
					if LBBody and LBBody.Parent then
						local ok, text = pcall(statusText)
						LBBody.Text = ok and text or "Couldn't read the leaderboards right now"
					end
					task.wait(2)
				end
			end)
			Hub.onShutdown(function()
				LBOn = false
				Climb.on = false
				Climb.loopId += 1
			end)
			Hub.climb = Climb -- egg hatching hooks in here
			end -- Leaderboard climber block

			-- Re-executing the script stops everything in this copy first
			Hub.onShutdown(function()
				AutoMobsOn = false
				MobsLoopId += 1
				Hold.follow = nil
				AutoMineOn = false
				MineLoopId += 1
				StockLoopOn = false
				for _, shop in ipairs(Shops) do shop.autoOn = false shop.loopId += 1 end
				AutoPlantOn, AutoHarvestOn, AutoCollectOn, AutoSellOn, AutoClaimOn, AutoFeedOn = false, false, false, false, false, false
				LoopId += 1
				HarvestLoopId += 1
				CollectLoopId += 1
				SellLoopId += 1
				ClaimLoopId += 1
				FeedLoopId += 1
				Hold.users = { shutdown = true }
				releaseHold("shutdown")
				hoverClear()
			end)
		end,
	},

