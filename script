local SAVE_NAME = { Farm = "AutoFarm" } -- renamed tabs keep their old saved settings
local TAB_LAST = { Extras = true }      -- tabs shown at the end of the tab list
local tabCount = 0
-- Every widget gets a LayoutOrder in the order it was made (the library leaves them all
-- at 0, and Roblox doesn't promise an order for ties), so nothing shuffles around.
local function keepOrder(container)
	local count = 0
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then count += 1 child.LayoutOrder = count end
	end
	container.ChildAdded:Connect(function(child)
		if child:IsA("GuiObject") then
			count += 1
			child.LayoutOrder = count
			if child.Name == "Section" then keepOrder(child) end
		end
	end)
end

Window.CreateTab = function(self, tabName, iconName)
	local tab = createTab(self, tabName, iconName)
	keepOrder(tab.PageContainer)
	Config.wrapTab(tab, SAVE_NAME[tabName] or tabName)
	tabCount += 1
	local button = self.TabsContainer and self.TabsContainer:FindFirstChild(tabName .. "_TabBtn")
	if button then button.LayoutOrder = TAB_LAST[tabName] and 1000 + tabCount or tabCount end
	return tab
end

--------------------------------------------------------------------
-- Home tab: universal features, shown in every supported game
--------------------------------------------------------------------
local function AddHomeTab(Window, VanixiaUI)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local TeleportService = game:GetService("TeleportService")
	local HttpService = game:GetService("HttpService")
	local VirtualUser = game:GetService("VirtualUser")
	local LocalPlayer = Players.LocalPlayer

	local HomeTab = Window:CreateTab("Home", "house")

	local function notify(title, text)
		VanixiaUI:CreateNotification({ Title = title, Description = text, Icon = "info", Theme = "Dark", Duration = 3 })
	end

	local function getHumanoid()
		local char = LocalPlayer.Character
		return char and char:FindFirstChildOfClass("Humanoid")
	end

	local function getRoot()
		local char = LocalPlayer.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	-- WalkSpeed / JumpPower: re-applied if the game or a respawn resets them
	local WalkSpeed, JumpPower -- nil = leave the game's value alone

	local function applyMovement()
		local hum = getHumanoid()
		if not hum then return end
		if WalkSpeed and hum.WalkSpeed ~= WalkSpeed then hum.WalkSpeed = WalkSpeed end
		if JumpPower then
			hum.UseJumpPower = true
			if hum.JumpPower ~= JumpPower then hum.JumpPower = JumpPower end
		end
	end

	local function watchHumanoid(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if not hum then return end
		hum:GetPropertyChangedSignal("WalkSpeed"):Connect(applyMovement)
		hum:GetPropertyChangedSignal("JumpPower"):Connect(applyMovement)
		applyMovement()
	end
	if LocalPlayer.Character then task.spawn(watchHumanoid, LocalPlayer.Character) end
	LocalPlayer.CharacterAdded:Connect(watchHumanoid)

	local MoveSec = UISection(HomeTab, "Movement")
	MoveSec:CreateSlider("WalkSpeed", 16, 250, 16, function(value)
		WalkSpeed = value
		applyMovement()
	end)

	MoveSec:CreateSlider("JumpPower", 50, 350, 50, function(value)
		JumpPower = value
		applyMovement()
	end)

	-- Infinite jump
	local InfJump = false
	UserInputService.JumpRequest:Connect(function()
		if InfJump and not Hub.isLocked() then -- paused while a farm feature holds you
			local hum = getHumanoid()
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end)
	MoveSec:CreateToggle("Infinite Jump", function(state) InfJump = state end)

	-- Fly: WASD moves where the camera looks, Space = up, Left Ctrl = down. Mobile uses the joystick.
	local Flying, FlySpeed = false, 60
	local flyConn, flyVelocity, flyGyro

	local function stopFly()
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if flyVelocity then flyVelocity:Destroy() flyVelocity = nil end
		if flyGyro then flyGyro:Destroy() flyGyro = nil end
		local hum = getHumanoid()
		-- leave PlatformStand alone while a farm feature is holding you
		if hum and not Hub.isLocked() then hum.PlatformStand = false end
	end

	local function startFly()
		stopFly()
		local root, hum = getRoot(), getHumanoid()
		if not root or not hum then return end

		flyVelocity = Instance.new("BodyVelocity")
		flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		flyVelocity.Velocity = Vector3.zero
		flyVelocity.Parent = root

		flyGyro = Instance.new("BodyGyro")
		flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		flyGyro.P = 9e4
		flyGyro.CFrame = root.CFrame
		flyGyro.Parent = root

		hum.PlatformStand = true

		flyConn = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			local dir = Vector3.zero
			if not UserInputService:GetFocusedTextBox() then
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
			end
			if dir.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then
				dir = hum.MoveDirection -- mobile joystick
			end
			flyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * FlySpeed or Vector3.zero
			flyGyro.CFrame = cam.CFrame
			if not hum.PlatformStand then hum.PlatformStand = true end -- the game can reset it
		end)
	end

	LocalPlayer.CharacterAdded:Connect(function(char)
		if Flying then
			char:WaitForChild("HumanoidRootPart", 10)
			task.wait(0.5)
			if Flying and not Hub.isLocked() then startFly() end
		end
	end)

	MoveSec:CreateToggle("Fly", function(state)
		Flying = state
		if not state then
			stopFly()
		elseif Hub.isLocked() then
			notify("Fly", "Paused while a farm feature (harvest, sell, feed) is moving you. It starts again after.")
		else
			startFly()
		end
	end)

	-- Farm features took over your character: pause Fly. Released: resume it if still on.
	Hub.onLockChanged(function(locked)
		if locked then
			if flyConn then
				stopFly()
				notify("Fly", "Paused while a farm feature is moving you")
			end
		elseif Flying then
			startFly()
		end
	end)

	MoveSec:CreateSlider("Fly Speed", 10, 300, 60, function(value) FlySpeed = value end)

	-- Noclip: walk through walls (collisions are put back when you turn it off)
	local Noclip = false
	local noclipParts = {}
	RunService.Stepped:Connect(function()
		if not Noclip then return end
		local char = LocalPlayer.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				noclipParts[part] = true
				part.CanCollide = false
			end
		end
	end)

	local function restoreCollisions()
		-- the farm mover handles collisions itself while it holds you
		if not Hub.isLocked() then
			for part in pairs(noclipParts) do
				if part.Parent then part.CanCollide = true end
			end
		end
		noclipParts = {}
	end

	MoveSec:CreateToggle("Noclip", function(state)
		Noclip = state
		if not state then restoreCollisions() end
	end)

	-- See Through: the map (walls, cave rock, buildings, trees) turns see-through so you
	-- can find your way in caves or while flying. Players, mobs, rocks, NPCs and items
	-- stay solid. Only on your screen; turning it off puts everything back.
	local SeeThrough = { on = false, changed = {}, conn = nil }
	local SEE_THROUGH = 0.7

	local function seeThroughPart(part)
		if (part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture")) and SeeThrough.changed[part] == nil then
			SeeThrough.changed[part] = part.LocalTransparencyModifier
			part.LocalTransparencyModifier = SEE_THROUGH
		end
	end

	MoveSec:CreateToggle("See Through Walls (caves / flying)", function(state)
		SeeThrough.on = state
		if SeeThrough.conn then SeeThrough.conn:Disconnect() SeeThrough.conn = nil end
		local map = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Map")
		if not state then
			for part, original in pairs(SeeThrough.changed) do
				if part.Parent then part.LocalTransparencyModifier = original end
			end
			SeeThrough.changed = {}
			return
		end
		if not map then return end
		task.spawn(function()
			for i, part in ipairs(map:GetDescendants()) do
				if not SeeThrough.on then return end
				seeThroughPart(part)
				if i % 3000 == 0 then task.wait() end -- spread out so the game doesn't freeze
			end
		end)
		SeeThrough.conn = map.DescendantAdded:Connect(function(part)
			if SeeThrough.on then task.defer(seeThroughPart, part) end
		end)
	end)
	Hub.onShutdown(function()
		if SeeThrough.conn then SeeThrough.conn:Disconnect() end
		for part, original in pairs(SeeThrough.changed) do
			if part.Parent then part.LocalTransparencyModifier = original end
		end
	end)

	-- Low Graphics (anti lag): deletes textures and decals, turns off particles,
	-- shadows and post effects, and makes every part plain plastic. Keeps doing
	-- it to new things while on. Only on your screen; rejoin to get the looks back.
	local Lighting = game:GetService("Lighting")
	local LowGfx = false
	local lowGfxConn

	local function simplify(inst)
		if inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance") then
			inst:Destroy()
		elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
			or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
			inst.Enabled = false
		elseif inst:IsA("MeshPart") then
			inst.Material = Enum.Material.SmoothPlastic
			inst.Reflectance = 0
			inst.CastShadow = false
			pcall(function() inst.TextureID = "" end)
		elseif inst:IsA("BasePart") then
			inst.Material = Enum.Material.SmoothPlastic
			inst.Reflectance = 0
			inst.CastShadow = false
		elseif inst:IsA("PostEffect") then
			inst.Enabled = false
		end
	end

	local PerfSec = UISection(HomeTab, "Performance & AFK")
	PerfSec:CreateButton("Low Graphics (anti lag, rejoin to undo)", function()
		if LowGfx then notify("Low Graphics", "Already on") return end
		LowGfx = true
		notify("Low Graphics", "Removing textures and effects... rejoin to undo")
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 1e9
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			pcall(function()
				terrain.WaterWaveSize, terrain.WaterWaveSpeed, terrain.WaterReflectance, terrain.WaterTransparency = 0, 0, 0, 0
				terrain.Decoration = false
			end)
		end
		for _, effect in ipairs(Lighting:GetChildren()) do
			if effect:IsA("PostEffect") or effect:IsA("Atmosphere") or effect:IsA("Clouds") then
				pcall(function() effect.Enabled = false end)
				if effect:IsA("Atmosphere") then effect.Density = 0 end
			end
		end
		task.spawn(function()
			for i, inst in ipairs(workspace:GetDescendants()) do
				if not LowGfx then return end
				pcall(simplify, inst)
				if i % 3000 == 0 then task.wait() end -- spread the work so the game doesn't freeze
			end
		end)
		lowGfxConn = workspace.DescendantAdded:Connect(function(inst)
			if LowGfx then task.defer(pcall, simplify, inst) end
		end)
	end)

	-- Stop drawing the 3D world entirely (biggest saving while AFK; the menu still works)
	local NoRender = false
	PerfSec:CreateToggle("Turn Off 3D Rendering (AFK)", function(state)
		NoRender = state
		RunService:Set3dRenderingEnabled(not state)
	end)

	-- Cap FPS (needs an executor with setfpscap)
	local FpsCapped = false
	PerfSec:CreateToggle("Cap FPS at 15 (AFK)", function(state)
		FpsCapped = state
		if typeof(setfpscap) ~= "function" then
			notify("FPS Cap", "Your executor doesn't support setfpscap")
			return
		end
		setfpscap(state and 15 or 60)
	end)

	-- Anti-AFK: stops the 20-minute idle kick
	local AntiAfk = false
	LocalPlayer.Idled:Connect(function()
		if AntiAfk then
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end
	end)
	PerfSec:CreateToggle("Anti-AFK", function(state) AntiAfk = state end)

	-- Saved settings
	-- Settings save automatically on every change and load automatically on start
	local MiscSec = UISection(HomeTab, "Server & Settings")
	MiscSec:CreateButton("Reset to Default (everything off)", function()
		task.spawn(function()
			Config.resetToDefault()
			notify("Settings", "Everything turned off and saved settings cleared")
		end)
	end)

	-- Rejoin the same server (or a new one if you are alone in it)
	MiscSec:CreateButton("Rejoin", function()
		notify("Rejoin", "Rejoining...")
		if #Players:GetPlayers() <= 1 then
			TeleportService:Teleport(game.PlaceId, LocalPlayer)
		else
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
		end
	end)

	-- Server hop: join a different public server that has room
	MiscSec:CreateButton("Server Hop", function()
		local ok, result = pcall(function()
			local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100"):format(game.PlaceId)
			return HttpService:JSONDecode(game:HttpGet(url))
		end)
		if not ok or type(result) ~= "table" or type(result.data) ~= "table" then
			notify("Server Hop", "Could not get the server list")
			return
		end
		for _, server in ipairs(result.data) do
			if server.id ~= game.JobId and server.playing < server.maxPlayers then
				notify("Server Hop", "Joining another server...")
				TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
				return
			end
		end
		notify("Server Hop", "No other server with free space found")
	end)

	-- Re-executing the script turns all of this off in the old copy
	Hub.onShutdown(function()
		Flying, InfJump, AntiAfk = false, false, false
		LowGfx = false
		if lowGfxConn then lowGfxConn:Disconnect() lowGfxConn = nil end
		if NoRender then RunService:Set3dRenderingEnabled(true) NoRender = false end
		if FpsCapped and typeof(setfpscap) == "function" then setfpscap(60) FpsCapped = false end
		stopFly()
		if Noclip then Noclip = false restoreCollisions() end
		WalkSpeed, JumpPower = nil, nil
	end)
end

