			local function feedPetsOnce()
				if not PetFood then return 0, "pick a Pet Food first" end
				local crops = readData("Crops") or {}
				local have = tonumber(crops[PetFood]) or 0
				local fieldPets = readData("FieldPets") or {}
				local targets = {}
				for penKey, pets in pairs(fieldPets) do
					local penIndex = tonumber(penKey)
					local pen = penIndex and penModel(penIndex)
					if pen and type(pets) == "table" then
						for _, pet in ipairs(pets) do
							if type(pet) == "table" and pet.Id and pet.X and pet.Z then
								local pos = pen:GetPivot():PointToWorldSpace(Vector3.new(pet.X, 0, pet.Z))
								table.insert(targets, { pen = penIndex, id = pet.Id, pos = pos })
							end
						end
					end
				end
				if #targets == 0 then return 0, "no pets found" end
				if have < 1 then return 0, ("no %s in your crops"):format(PetFood) end

				local fed = 0
				if acquireHold("feed") then
					withMover(function()
						Cave.surface() -- your pets are on the surface: go up first if in the cave
						for _, pet in ipairs(targets) do
							if fed >= have then break end
							moveUnder(pet.pos)
							task.wait(0.6)
							RemoteManager.Fire("PetAction", "FeedMany", pet.pen, pet.id, PetFood, 1)
							fed += 1
						end
						task.wait(0.5)
					end)
				end
				releaseHold("feed")
				return fed
			end

