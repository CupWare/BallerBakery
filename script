-- BallerBakery Hub (VanixiaUI)
-- To add a game: copy one block inside Games, change the ID, Author and Load function.

--------------------------------------------------------------------
-- Shared hub state, so features don't fight each other
--------------------------------------------------------------------
local Hub = { locks = {}, listeners = {}, shutdownFns = {} }

-- A "movement lock" is on while a farm feature controls your character.
-- Fly and Infinite Jump pause while it's on and come back when it's off.
function Hub.isLocked()
	return next(Hub.locks) ~= nil
end

function Hub.lock(name, on)
	local was = Hub.isLocked()
	Hub.locks[name] = on and true or nil
	local now = Hub.isLocked()
	if was ~= now then
		for _, fn in ipairs(Hub.listeners) do
			local ok, err = pcall(fn, now)
			if not ok then warn("[BallerBakery] " .. tostring(err)) end
		end
	end
end

function Hub.onLockChanged(fn)
	table.insert(Hub.listeners, fn)
end

-- Cleanup run when the script is executed again, so two copies never run at once
function Hub.onShutdown(fn)
	table.insert(Hub.shutdownFns, fn)
end

function Hub.shutdown()
	local fns = Hub.shutdownFns
	Hub.shutdownFns = {}
	for _, fn in ipairs(fns) do pcall(fn) end
end

--------------------------------------------------------------------
-- Saved settings: every toggle, dropdown pick, slider and multi-pick list is
-- saved to a file (one per game, in your executor's workspace folder) and
-- loaded back automatically the next time you run the script.
--------------------------------------------------------------------
local Config = { values = {}, controls = {}, counts = {}, multis = {}, loading = false }
local ConfigHttp = game:GetService("HttpService")
local CONFIG_FOLDER = "BallerBakery"
local CONFIG_FILE = CONFIG_FOLDER .. "/" .. tostring(game.PlaceId) .. ".json"
local CAN_SAVE = typeof(writefile) == "function" and typeof(readfile) == "function"

function Config.read()
	if not CAN_SAVE then return end
	local ok, text = pcall(function()
		if typeof(isfile) == "function" and not isfile(CONFIG_FILE) then return nil end
		return readfile(CONFIG_FILE)
	end)
	if ok and type(text) == "string" and text ~= "" then
		local decoded, data = pcall(ConfigHttp.JSONDecode, ConfigHttp, text)
		if decoded and type(data) == "table" then Config.values = data end
	end
end

local saveQueued = false
function Config.save()
	if not CAN_SAVE or Config.loading or saveQueued then return end
	saveQueued = true
	task.delay(0.5, function() -- group quick changes into one write
		saveQueued = false
		pcall(function()
			if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(CONFIG_FOLDER) then
				makefolder(CONFIG_FOLDER)
			end
			writefile(CONFIG_FILE, ConfigHttp:JSONEncode(Config.values))
		end)
	end)
end

function Config.get(key) return Config.values[key] end
function Config.set(key, value)
	Config.values[key] = value
	Config.save()
end

function Config.reset()
	Config.values = {}
	if CAN_SAVE then
		pcall(function()
			if typeof(delfile) == "function" then delfile(CONFIG_FILE) else writefile(CONFIG_FILE, "{}") end
		end)
	end
end

-- Same title twice on one tab (e.g. the 3 "Crop" dropdowns) gets #2, #3 ...
local function configKey(tabName, kind, title)
	local base = tabName .. "/" .. kind .. "/" .. tostring(title)
	Config.counts[base] = (Config.counts[base] or 0) + 1
	return Config.counts[base] == 1 and base or (base .. "#" .. Config.counts[base])
end

-- Presses a UI button from code. Calls the click handlers directly: firesignal
-- silently fails on handlers that wait (tested: the library's dropdown options).
local function pressButton(button)
	local pressed = false
	if typeof(getconnections) == "function" then
		for _, c in ipairs(getconnections(button.MouseButton1Click)) do
			if typeof(c.Function) == "function" then
				task.spawn(c.Function)
				pressed = true
			end
		end
	end
	if not pressed and typeof(firesignal) == "function" then
		firesignal(button.MouseButton1Click)
	end
end

-- A titled group box inside a tab (keeps the UI tidy). Supports toggles, buttons,
-- dropdowns, inputs, sliders and paragraphs; settings inside still save under the tab.
local function UISection(tab, title)
	local section = tab:CreateSection(title)
	section.CreateSlider = tab.CreateSlider
	section.CreateParagraph = tab.CreateParagraph
	section.SelectedTheme = section.SelectedTheme or tab.SelectedTheme
	return section
end

-- Records every toggle / dropdown / slider a tab creates, and saves its value on change
function Config.wrapTab(tab, tabName)
	local page = tab.PageContainer
	local function snapshot(where)
		local t = {}
		for _, c in ipairs((where or page):GetChildren()) do t[c] = true end
		return t
	end
	local function newChild(before, name, where)
		for _, c in ipairs((where or page):GetChildren()) do
			if not before[c] and c.Name == name then return c end
		end
	end

	local createToggle = tab.CreateToggle
	tab.CreateToggle = function(self, title, callback)
		local key = configKey(tabName, "toggle", title)
		local before = snapshot(self.PageContainer) -- self may be a section
		createToggle(self, title, function(state)
			Config.set(key, state)
			callback(state)
		end)
		local frame = newChild(before, "Toggle", self.PageContainer)
		if frame then table.insert(Config.controls, { kind = "toggle", key = key, frame = frame }) end
	end

	local createDropdown = tab.CreateDropdown
	tab.CreateDropdown = function(self, title, list, callback)
		local key = configKey(tabName, "dropdown", title)
		local before = snapshot(self.PageContainer)
		createDropdown(self, title, list, function(value)
			Config.set(key, value)
			callback(value)
		end)
		local frame = newChild(before, "Dropdown", self.PageContainer)
		if frame then table.insert(Config.controls, { kind = "dropdown", key = key, frame = frame }) end
	end

	local createSlider = tab.CreateSlider
	tab.CreateSlider = function(self, title, min, max, default, callback)
		local key = configKey(tabName, "slider", title)
		local saved = Config.get(key)
		local start = type(saved) == "number" and math.clamp(saved, min, max) or default
		createSlider(self, title, min, max, start, function(value)
			Config.set(key, value)
			callback(value)
		end)
		table.insert(Config.controls, {
			kind = "slider", key = key,
			apply = type(saved) == "number" and function() callback(start) end or nil,
			reset = function() callback(default) end,
		})
	end
end

-- Reset to default: every toggle off, sliders back to default, multi-pick lists
-- cleared, saved file wiped. Toggles go off newest-first (auto features before gardens).
function Config.resetToDefault()
	Config.loading = true
	for i = #Config.controls, 1, -1 do
		local control = Config.controls[i]
		pcall(function()
			if control.kind == "toggle" and Config.values[control.key] == true and control.frame.Parent then
				pressButton(control.frame.ToggleInvisibleClick)
				task.wait(0.05)
			elseif control.kind == "slider" and control.reset then
				control.reset()
			end
		end)
	end
	for _, multi in ipairs(Config.multis) do
		for name in pairs(multi.selected) do multi.selected[name] = nil end
		pcall(multi.refresh)
	end
	task.wait(0.3)
	Config.loading = false
	Config.reset()
end

-- Turns saved settings back on, in the order the UI was built
function Config.applyAll()
	Config.loading = true
	local applied = 0
	for _, control in ipairs(Config.controls) do
		local saved = Config.get(control.key)
		local ok = pcall(function()
			if control.kind == "toggle" and saved == true and control.frame.Parent then
				pressButton(control.frame.ToggleInvisibleClick)
				applied += 1
			elseif control.kind == "dropdown" and type(saved) == "string" and control.frame.Parent then
				local option = control.frame:FindFirstChild(saved .. "_Option", true)
				if option then pressButton(option) applied += 1 end
			elseif control.kind == "slider" and control.apply then
				control.apply()
				applied += 1
			end
		end)
		if ok then task.wait(0.05) end
	end
	task.wait(0.5) -- dropdowns call back a moment after the click
	Config.loading = false
	return applied
end

