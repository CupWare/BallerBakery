			-- { {name, left, total, price}, ... } for everything in stock right now
			local function currentStock(shop)
				local now = workspace:GetServerTimeNow()
				local period = shop.config.Period(now)
				local ok, bought = pcall(HttpService.JSONDecode, HttpService, LocalPlayer:GetAttribute(shop.bought) or "{}")
				if not ok or type(bought) ~= "table" then bought = {} end
				local list = {}
				for _, name in ipairs(shop.config.List()) do
					local total = shop.config.StockOf(name, period)
					if total > 0 then
						local used = (bought.Period == period and tonumber(bought[name])) or 0
						table.insert(list, { name = name, left = math.max(0, total - used), total = total, price = shop.config.Get(name).Price })
					end
				end
				return list, shop.config.NextRestock(now) - now
			end

			local function stockText(shop)
				local list, restockIn = currentStock(shop)
				local lines = {}
				for _, item in ipairs(list) do
					table.insert(lines, ("%s  %d/%d  (%d)%s"):format(item.name, item.left, item.total, item.price,
						shop.selected[item.name] and "  [auto]" or ""))
				end
				if #lines == 0 then table.insert(lines, "Nothing in stock") end
				table.insert(lines, ("Restocks in %d:%02d"):format(math.floor(restockIn / 60), math.floor(restockIn % 60)))
				return table.concat(lines, "\n")
			end

			-- Buys every selected item that's in stock and affordable
			local function buySelected(shop)
				local toBuy = {}
				for _, item in ipairs(currentStock(shop)) do
					if shop.selected[item.name] and item.left > 0 and crackles() >= item.price then
						table.insert(toBuy, item)
					end
				end
				if #toBuy == 0 then return 0 end

				local npcs = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("NPCs")
				local npc = Cave.reachNpc(shop.npc, "shop" .. shop.key) -- goes to where the seller was if they unloaded
				if not npc and Cave.inside(Cave.myPos()) and acquireHold("shop" .. shop.key) then -- shops are on the surface
					withMover(Cave.surface)
					npc = npcs and npcs:FindFirstChild(shop.npc)
					if not npc then releaseHold("shop" .. shop.key) end
				end
				if not npc then return 0 end

				local bought = 0
				local user = "shop" .. shop.key
				if acquireHold(user) then
					withMover(function()
						moveUnder(npc:GetPivot().Position)
						Cave.waitSettled() -- until the server has seen you at the seller
						for _, item in ipairs(toBuy) do
							for _ = 1, item.left do
								if crackles() < item.price then break end
								local before = crackles()
								RemoteManager.Fire(shop.remote, item.name)
								local t0 = os.clock()
								while crackles() == before and os.clock() - t0 < 1.5 do task.wait() end
								if crackles() == before then break end -- server said no (sold out / can't buy)
								bought += 1
							end
						end
					end)
				end
				releaseHold(user)
				return bought
			end

